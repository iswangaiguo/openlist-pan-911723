+.drive-usage {
+  margin-top: auto;
+  padding: 20px 10px;
+  border-top: 1px solid var(--drive-line);
+}
+.drive-usage > span {
+  color: var(--drive-muted);
+  font-size: 12px;
+}
+.drive-usage strong {
+  display: block;
+  margin-top: 10px;
+  font-size: 14px;
+}
+.drive-usage small {
+  display: block;
+  color: var(--drive-muted);
+  margin-top: 6px;
+}
+.drive-usage p {
+  color: var(--drive-muted);
+  font-size: 12px;
+  margin: 10px 0 0;
+}
+.drive-usage button {
+  border: 0;
+  background: transparent;
+  color: var(--drive-blue);
+  padding: 8px 0;
+}
