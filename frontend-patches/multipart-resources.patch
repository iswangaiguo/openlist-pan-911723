diff --git a/src/utils/request.ts b/src/utils/request.ts
index a3f6bd3..c4b11b9 100644
--- a/src/utils/request.ts
+++ b/src/utils/request.ts
@@ -75,15 +75,24 @@ instance.interceptors.response.use(
