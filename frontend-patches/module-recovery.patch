diff --git a/src/components/ModuleLoadError.tsx b/src/components/ModuleLoadError.tsx
new file mode 100644
index 0000000..aae3eeb
--- /dev/null
+++ b/src/components/ModuleLoadError.tsx
@@ -0,0 +1,73 @@
+import { Button, Text } from "@hope-ui/solid"
+import { onMount, Show } from "solid-js"
+import { currentLang } from "~/app/i18n"
+import {
+  claimModuleReload,
+  isModuleLoadError,
+  unfinishedUploads,
+} from "~/utils/module_recovery"
+import { Error } from "./Base"
+
+export const ModuleLoadError = (props: { error: unknown }) => {
+  const moduleError = () => isModuleLoadError(props.error)
+  const text = (zh: string, en: string) =>
+    String(currentLang()).startsWith("zh") ? zh : en
+  // Only the initial failure may reload automatically. Finishing an upload later
+  // does not unexpectedly refresh a page the user has continued working in.
+  const blockedInitially = unfinishedUploads() > 0
+  onMount(() => {
+    if (!moduleError() || blockedInitially) return
+    try {
+      if (
+        claimModuleReload(sessionStorage, Date.now(), unfinishedUploads() > 0)
+      )
+        location.reload()
+    } catch {
+      /* Show the explicit recovery button if storage is unavailable. */
+    }
+  })
+  const reload = () => {
+    if (unfinishedUploads() > 0) return
+    try {
+      sessionStorage.setItem("openlist:module-reload", String(Date.now()))
+    } catch {}
+    location.reload()
+  }
+  return (
+    <Error
+      msg={
+        moduleError()
+          ? text(
+              "页面资源未能加载，可能是版本更新或网络问题。",
+              "Page resources could not load. The site may have updated or the network may be unavailable.",
+            )
+          : String(props.error)
+      }
+      disableColor
+      actions={
+        <Show when={moduleError()}>
+          <div
+            style={{
+              display: "flex",
+              "flex-direction": "column",
+              gap: "16px",
+              "align-items": "center",
+            }}
+          >
+            <Show when={unfinishedUploads() > 0}>
+              <Text>
+                {text(
+                  "上传任务仍保留，请先完成或取消任务，再重新加载页面。",
+                  "Uploads are preserved. Finish or cancel them before reloading.",
+                )}
+              </Text>
+            </Show>
+            <Button disabled={unfinishedUploads() > 0} onClick={reload}>
+              {text("重新加载页面", "Reload page")}
+            </Button>
+          </div>
+        </Show>
+      }
+    />
+  )
+}
