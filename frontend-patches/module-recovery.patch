diff --git a/src/utils/module_recovery.ts b/src/utils/module_recovery.ts
new file mode 100644
index 0000000..ab2558f
--- /dev/null
+++ b/src/utils/module_recovery.ts
@@ -0,0 +1,27 @@
+import { createSignal } from "solid-js"
+
+const [unfinishedUploads, setUnfinishedUploads] = createSignal(0)
+export { unfinishedUploads, setUnfinishedUploads }
+export const isModuleLoadError = (error: unknown) =>
+  /Failed to fetch dynamically imported module|Importing a module script failed|error loading dynamically imported module|Unable to preload CSS|Loading (?:CSS )?chunk [\w-]+ failed/i.test(
+    String(error),
+  )
+
+// Reload at most once per tab within 15 minutes; persistent network/CDN failures
+// need an explicit retry rather than an infinite reload loop. Storage failures
+// also require an explicit retry because we cannot persist the loop guard.
+export function claimModuleReload(
+  storage: Pick<Storage, "getItem" | "setItem">,
+  now: number,
+  blocked = false,
+) {
+  if (blocked) return false
+  try {
+    const previous = Number(storage.getItem("openlist:module-reload"))
+    if (previous > 0 && now - previous < 15 * 60 * 1000) return false
+    storage.setItem("openlist:module-reload", String(now))
+    return true
+  } catch {
+    return false
+  }
+}
diff --git a/src/utils/read_deadline.ts b/src/utils/read_deadline.ts
new file mode 100644
index 0000000..49661f0
--- /dev/null
+++ b/src/utils/read_deadline.ts
@@ -0,0 +1,72 @@
+import type { InternalAxiosRequestConfig } from "axios"
+
+const READ_DEADLINE_MS = 30_000
+const reads = new WeakMap<object, { expired: boolean; finish: () => void }>()
+const isBoundedRead = (config: InternalAxiosRequestConfig) => {
+  const method = (config.method || "get").toLowerCase()
+  const path = (config.url || "").split("?")[0]
+  return (
+    (method === "get" &&
+      [
+        "/public/settings",
+        "/public/init_status",
+        "/public/archive_extensions",
+        "/me",
+      ].includes(path)) ||
+    (method === "post" && ["/fs/get", "/fs/list"].includes(path))
+  )
+}
+
+// Limit page-startup and file metadata reads only. Uploads, downloads and file
+// mutations retain their original timing and are never automatically replayed.
+export function boundReadRequest(config: InternalAxiosRequestConfig) {
+  if (!isBoundedRead(config)) return config
+  const previous = config.signal,
+    controller = new AbortController()
+  const timeout =
+    config.timeout && config.timeout > 0 ? config.timeout : READ_DEADLINE_MS
+  const deadline = Date.now() + timeout
+  const expire = () => {
+    state.expired = true
+    controller.abort(new DOMException("Read request timed out", "TimeoutError"))
+  }
+  const check = () => {
+    if (Date.now() >= deadline) expire()
+  }
+  const visibility = () => {
+    if (!document.hidden) check()
+  }
+  const cancel = () => controller.abort()
+  const timer = window.setTimeout(expire, timeout)
+  const state = {
+    expired: false,
+    finish: () => {
+      window.clearTimeout(timer)
+      window.removeEventListener("focus", check)
+      window.removeEventListener("online", check)
+      window.removeEventListener("pageshow", check)
+      document.removeEventListener("resume", check)
+      document.removeEventListener("visibilitychange", visibility)
+      previous?.removeEventListener?.("abort", cancel)
+    },
+  }
+  reads.set(controller.signal, state)
+  controller.signal.addEventListener("abort", state.finish, { once: true })
+  window.addEventListener("focus", check)
+  window.addEventListener("online", check)
+  window.addEventListener("pageshow", check)
+  document.addEventListener("resume", check)
+  document.addEventListener("visibilitychange", visibility)
+  previous?.addEventListener?.("abort", cancel, { once: true })
+  if (previous?.aborted) cancel()
+  config.signal = controller.signal
+  config.timeout = timeout
+  return config
+}
+
+export function finishReadRequest(config?: InternalAxiosRequestConfig) {
+  if (config?.signal) reads.get(config.signal)?.finish()
+}
+export function didReadExpire(config?: InternalAxiosRequestConfig) {
+  return !!(config?.signal && reads.get(config.signal)?.expired)
+}
