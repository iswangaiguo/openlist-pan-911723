+import type {
+  Upload,
+  UploadCheckpoint,
+  UploadFileProps,
+  MultipartResume,
+} from "./types"
+import type { UploadPersistence } from "./recovery"
+import { savedUpload } from "./recovery"
+
+export interface UploadTarget {
+  directory: string
+  password: string
+  uploader: Upload
+  method: string
+  asTask: boolean
+  overwrite: boolean
+  rapid: boolean
+}
+export interface UploadTask extends UploadFileProps {
+  id: number
+  directory: string
+  method: string
+  confirmedBytes: number
+  requiresPassword: boolean
+  resumable: boolean
+}
+interface Job {
+  task: UploadTask
+  file?: File
+  lastModified: number
+  fileName: string
+  target: UploadTarget
+  resume: MultipartResume
+  persistence?: UploadPersistence
+  controller?: AbortController
+  running: boolean
+}
+interface QueueOptions {
+  warning?: () => void
+  exclusive?: (
+    token: string,
+    run: () => Promise<Error | undefined>,
+  ) => Promise<Error | undefined>
+  discard?: (uploadId: string) => Promise<unknown>
+  probe?: (
+    uploadId: string,
+    signal: AbortSignal,
+  ) => Promise<"completed" | undefined>
+}
+
+// The queue owns transports and recovery records independently of the panel.
+export class UploadQueue {
+  private jobs: Job[] = []
+  private serial = 0
+  private running = 0
+  private online = true
+  private persistence?: UploadPersistence
+  constructor(
+    private changed: (tasks: UploadTask[]) => void,
+    private completed: (directory: string) => void,
+    private concurrency = 3,
+    private options: QueueOptions = {},
+  ) {}
+  private emit() {
+    this.changed(this.jobs.map(({ task }) => ({ ...task })))
+  }
+  private save(job: Job) {
+    try {
+      if (["success", "cancelled"].includes(job.task.status))
+        job.persistence?.remove(job.resume.token)
+      else
+        job.persistence?.save(
+          savedUpload(
+            job.task,
+            job.target,
+            job.lastModified,
+            job.fileName,
+            job.resume,
+          ),
+        )
+    } catch {
+      this.options.warning?.()
+    }
+  }
+  restore(
+    persistence: UploadPersistence,
+    uploader: (name: string) => Upload | undefined,
+  ) {
+    this.persistence = persistence
+    try {
+      for (const record of persistence.load()) {
+        const upload = uploader(record.method)
+        if (
+          !upload ||
+          this.jobs.some((job) => job.resume.token === record.token)
+        )
+          continue
+        this.jobs.push({
+          running: false,
+          persistence,
+          lastModified: record.lastModified,
+          fileName: record.fileName,
+          target: {
+            directory: record.directory,
+            password: "",
+            uploader: upload,
+            method: record.method,
+            asTask: record.asTask,
+            overwrite: record.overwrite,
+            rapid: record.rapid,
+          },
+          resume: record.resume,
+          task: {
+            id: ++this.serial,
+            name: record.name,
+            path: record.path,
+            directory: record.directory,
+            size: record.size,
+            method: record.method,
+            speed: 0,
+            status: "needs_file",
+            progress: record.size
+              ? (record.confirmedBytes / record.size) * 100
+              : 0,
+            confirmedBytes: record.confirmedBytes,
+            requiresPassword: record.requiresPassword,
+            resumable:
+              record.method === "Multipart" &&
+              record.resume.supported !== false,
+          },
+        })
+      }
+    } catch {
+      this.options.warning?.()
+    }
+    this.emit()
+    for (const job of this.jobs)
+      if (job.task.status === "needs_file" && job.resume.uploadId)
+        void this.probe(job)
+  }
+  private async probe(job: Job) {
+    if (!this.options.probe || !job.resume.uploadId) return
+    const controller = (job.controller = new AbortController())
+    try {
+      const state = await this.options.probe(
+        job.resume.uploadId,
+        controller.signal,
+      )
+      if (
+        controller.signal.aborted ||
+        !this.jobs.includes(job) ||
+        job.task.status !== "needs_file"
+      )
+        return
+      if (state === "completed") {
+        Object.assign(job.task, {
+          status: "success",
+          progress: 100,
+          confirmedBytes: job.task.size,
+        })
+        this.save(job)
+        this.emit()
+        this.completed(job.task.directory)
+      }
+    } catch {
+      /* A failed status check must not discard a recoverable upload. */
+    } finally {
+      if (job.controller === controller) job.controller = undefined
+    }
+  }
+  add(files: File[], target: UploadTarget) {
+    for (const file of files) {
+      const relative = file.webkitRelativePath || file.name
+      const path = `${target.directory.replace(/\/$/, "")}/${relative}`
+      const job: Job = {
+        file,
+        target: { ...target },
+        running: false,
+        lastModified: file.lastModified ?? 0,
+        fileName: file.name.split("/").pop()!,
+        persistence: this.persistence,
+        resume: { token: crypto.randomUUID(), parts: {} },
+        task: {
+          id: ++this.serial,
+          name: file.name,
+          path,
+          directory: target.directory,
+          method: target.method,
+          size: file.size,
+          progress: 0,
+          speed: 0,
+          confirmedBytes: 0,
+          requiresPassword: !!target.password,
+          resumable: target.method === "Multipart",
+          status: this.online ? "pending" : "waiting_network",
+        },
+      }
+      this.jobs.push(job)
+      this.save(job) // Persist identity before the first request can start.
+    }
+    this.emit()
+    this.pump()
+  }
+  attach(id: number, file: File, password = "") {
+    const job = this.jobs.find((j) => j.task.id === id)
+    if (!job || job.running || job.task.status !== "needs_file") return false
+    if (
+      file.name.split("/").pop() !== job.fileName ||
+      file.size !== job.task.size ||
+      file.lastModified !== job.lastModified
+    ) {
+      job.task.msg =
+        "所选文件与原文件的名称、大小或修改时间不一致。请选择原文件；修改后的文件请重新添加。 / Original file does not match."
+      this.emit()
+      return false
+    }
+    job.file = file
+    job.target.password = password
+    this.resume(id)
+    return true
+  }
+  retry(id: number) {
+    const job = this.jobs.find((j) => j.task.id === id)
+    if (!job || job.running || job.task.status !== "error") return
+    this.resume(id)
+  }
+  pause(id: number) {
+    const job = this.jobs.find((j) => j.task.id === id)
+    if (
+      !job ||
+      ["success", "error", "cancelled", "needs_file"].includes(job.task.status)
+    )
+      return
+    job.task.status = "paused"
+    job.task.progress = job.task.size
+      ? (job.task.confirmedBytes / job.task.size) * 100
+      : 0
+    job.task.speed = 0
+    job.controller?.abort()
+    this.save(job)
+    this.emit()
+  }
+  resume(id: number) {
+    const job = this.jobs.find((j) => j.task.id === id)
+    if (!job || ["success", "cancelled"].includes(job.task.status)) return
+    job.task.status = !job.file
+      ? "needs_file"
+      : this.online
+        ? "pending"
+        : "waiting_network"
+    job.task.msg = ""
+    job.task.speed = 0
+    this.save(job)
+    this.emit()
+    this.pump()
+  }
+  restart(id: number) {
+    const job = this.jobs.find((j) => j.task.id === id)
+    if (!job?.file || job.running || job.task.status !== "error") return
+    this.discard(job)
+    job.resume = { token: crypto.randomUUID(), parts: {} }
+    job.task.confirmedBytes = 0
+    job.task.progress = 0
+    this.resume(id)
+  }
+  setOnline(online: boolean) {
+    this.online = online
+    for (const job of this.jobs) {
+      if (
+        !online &&
+        ["pending", "verifying", "hashing", "uploading", "backending"].includes(
+          job.task.status,
+        )
+      ) {
+        job.task.status = "waiting_network"
+        job.task.progress = job.task.size
+          ? (job.task.confirmedBytes / job.task.size) * 100
+          : 0
+        job.task.speed = 0
+        job.controller?.abort()
+        this.save(job)
+      } else if (online && job.task.status === "waiting_network") {
+        job.task.status = job.file ? "pending" : "needs_file"
+        this.save(job)
+      }
+    }
+    this.emit()
+    this.pump()
+  }
+  private discard(job: Job) {
+    try {
+      job.persistence?.remove(job.resume.token)
+    } catch {
+      this.options.warning?.()
+    }
+    if (job.resume.uploadId)
+      void this.options.discard?.(job.resume.uploadId).catch(() => {})
+  }
+  cancel(id: number) {
+    const job = this.jobs.find((j) => j.task.id === id)
+    if (!job || ["success", "cancelled"].includes(job.task.status)) return
+    job.task.status = "cancelled"
+    job.task.speed = 0
+    job.controller?.abort()
+    if (!job.running) job.file = undefined
+    this.discard(job)
+    this.emit()
+  }
+  clearDone() {
+    this.jobs = this.jobs.filter(
+      (j) => j.running || !["success", "cancelled"].includes(j.task.status),
+    )
+    this.emit()
+  }
+  // Logout/unmount relinquishes File handles but keeps recovery metadata for its owner.
+  reset() {
+    for (const job of this.jobs) {
+      if (!["success", "cancelled"].includes(job.task.status))
+        job.task.status = "needs_file"
+      job.controller?.abort()
+      job.file = undefined
+      this.save(job)
+    }
+    this.jobs = []
+    this.persistence = undefined
+    this.emit()
+  }
+  private pump() {
+    if (!this.online) return
+    while (this.running < this.concurrency) {
+      const job = this.jobs.find(
+        (j) => !j.running && j.task.status === "pending" && j.file,
+      )
+      if (!job) break
+      void this.run(job)
+    }
+  }
+  private checkpoint(job: Job, update: UploadCheckpoint) {
+    if (update.uploadId !== undefined) job.resume.uploadId = update.uploadId
+    if (update.chunkSize !== undefined) job.resume.chunkSize = update.chunkSize
+    if (update.supported !== undefined) {
+      job.resume.supported = update.supported
+      job.task.resumable = update.supported
+    }
+    if (update.part) job.resume.parts[update.part.index] = update.part.digest
+    if (update.confirmedBytes !== undefined)
+      job.task.confirmedBytes = update.confirmedBytes
+    this.save(job) // A digest is committed before sending its corresponding chunk.
+    this.emit()
+  }
+  private async run(job: Job) {
+    this.running++
+    job.running = true
+    const controller = (job.controller = new AbortController())
+    job.task.status = "uploading"
+    this.save(job)
+    this.emit()
+    const target = job.target
+    try {
+      const run = async () => {
+        controller.signal.throwIfAborted()
+        // Another tab may have advanced the durable ledger since this tab loaded.
+        try {
+          const latest = job.persistence?.get(job.resume.token)
+          if (latest) job.resume = latest.resume
+        } catch {
+          this.options.warning?.()
+        }
+        return target.uploader(
+          job.task.path,
+          job.file!,
+          (key, value) => {
+            if (controller.signal.aborted) return
+            Object.assign(job.task, { [key]: value })
+            this.emit()
+          },
+          target.asTask,
+          target.overwrite,
+          target.rapid,
+          {
+            password: target.password,
+            signal: controller.signal,
+            resume: job.resume,
+            checkpoint: (update) => {
+              if (!controller.signal.aborted) this.checkpoint(job, update)
+            },
+          },
+        )
+      }
+      const error = await (this.options.exclusive
+        ? this.options.exclusive(job.resume.token, run)
+        : run())
+      if (controller.signal.aborted) return
+      if (error) throw error
+      Object.assign(job.task, {
+        status: "success",
+        progress: 100,
+        confirmedBytes: job.task.size,
+        speed: 0,
+      })
+      job.file = undefined
+      this.save(job)
+      this.completed(target.directory)
+    } catch (error) {
+      if (!controller.signal.aborted) {
+        Object.assign(job.task, {
+          status: "error",
+          speed: 0,
+          msg: error instanceof Error ? error.message : String(error),
+        })
+        this.save(job)
+      }
+    } finally {
+      job.running = false
+      job.controller = undefined
+      if (["cancelled", "needs_file"].includes(job.task.status))
+        job.file = undefined
+      this.running--
+      this.emit()
+      this.pump()
+    }
+  }
+}
diff --git a/src/pages/home/uploads/recovery.ts b/src/pages/home/uploads/recovery.ts
new file mode 100644
index 0000000..b3d3a93
--- /dev/null
+++ b/src/pages/home/uploads/recovery.ts
@@ -0,0 +1,208 @@
+import type { UploadTask, UploadTarget } from "./queue"
+import type { MultipartResume } from "./types"
+
+export interface SavedUpload {
+  version: 1
+  token: string
+  name: string
+  path: string
+  directory: string
+  size: number
+  lastModified: number
+  fileName: string
+  method: string
+  asTask: boolean
+  overwrite: boolean
+  rapid: boolean
+  requiresPassword: boolean
+  confirmedBytes: number
+  resume: MultipartResume
+  updatedAt: number
+}
+export interface UploadPersistence {
+  load(): SavedUpload[]
+  get(token: string): SavedUpload | undefined
+  save(record: SavedUpload): void
+  remove(token: string): void
+}
+
+// Store metadata and browser-generated part digests only. File contents,
+// directory passwords and login tokens never enter recovery records.
+export class BrowserUploadPersistence implements UploadPersistence {
+  private prefix: string
+  constructor(
+    private storage: Storage,
+    scope: string,
+  ) {
+    this.prefix = `openlist:uploads:v1:${scope}:`
+  }
+  load() {
+    const records: SavedUpload[] = []
+    for (let i = 0; i < this.storage.length; i++) {
+      const key = this.storage.key(i)
+      if (!key?.startsWith(this.prefix)) continue
+      const record = this.get(key.slice(this.prefix.length))
+      if (record) records.push(record)
+    }
+    return records.sort((a, b) => a.updatedAt - b.updatedAt)
+  }
+  get(token: string) {
+    try {
+      const raw = this.storage.getItem(this.prefix + token)
+      if (!raw || raw.length > 1200000) return
+      const record = JSON.parse(raw)
+      if (
+        record.version !== 1 ||
+        record.token !== token ||
+        !/^[a-zA-Z0-9_-]{16,128}$/.test(token)
+      )
+        return
+      for (const key of ["name", "path", "directory", "fileName"]) {
+        if (
+          typeof record[key] !== "string" ||
+          !record[key] ||
+          record[key].length > 4096 ||
+          record[key].includes("\0")
+        )
+          return
+      }
+      if (!record.path.startsWith("/") || !record.directory.startsWith("/"))
+        return
+      if (
+        !["Multipart", "Stream", "Form", "HTTP Direct"].includes(record.method)
+      )
+        return
+      for (const key of ["asTask", "overwrite", "rapid", "requiresPassword"])
+        if (typeof record[key] !== "boolean") return
+      for (const key of [
+        "size",
+        "lastModified",
+        "confirmedBytes",
+        "updatedAt",
+      ]) {
+        if (!Number.isSafeInteger(record[key]) || record[key] < 0) return
+      }
+      if (
+        record.confirmedBytes > record.size ||
+        !record.resume ||
+        record.resume.token !== token
+      )
+        return
+      const resume = record.resume
+      if (
+        resume.uploadId !== undefined &&
+        (typeof resume.uploadId !== "string" ||
+          !/^mp_[a-zA-Z0-9_-]+$/.test(resume.uploadId))
+      )
+        return
+      if (
+        resume.chunkSize !== undefined &&
+        (!Number.isSafeInteger(resume.chunkSize) ||
+          resume.chunkSize < 1 ||
+          resume.chunkSize > 64 * 1024 * 1024)
+      )
+        return
+      if (
+        !resume.parts ||
+        typeof resume.parts !== "object" ||
+        Array.isArray(resume.parts)
+      )
+        return
+      if (Object.keys(resume.parts).length > 10000) return
+      for (const [index, digest] of Object.entries(resume.parts)) {
+        if (
+          !/^\d+$/.test(index) ||
+          Number(index) >= 10000 ||
+          typeof digest !== "string" ||
+          !/^[a-f0-9]{64}$/.test(digest)
+        )
+          return
+      }
+      if (
+        resume.supported !== undefined &&
+        typeof resume.supported !== "boolean"
+      )
+        return
+      // Copy an explicit allowlist: unrecognized fields cannot become credentials.
+      return {
+        version: 1,
+        token,
+        name: record.name,
+        path: record.path,
+        directory: record.directory,
+        size: record.size,
+        lastModified: record.lastModified,
+        fileName: record.fileName,
+        method: record.method,
+        asTask: record.asTask,
+        overwrite: record.overwrite,
+        rapid: record.rapid,
+        requiresPassword: record.requiresPassword,
+        confirmedBytes: record.confirmedBytes,
+        updatedAt: record.updatedAt,
+        resume: {
+          token,
+          uploadId: resume.uploadId,
+          chunkSize: resume.chunkSize,
+          parts: { ...resume.parts },
+          supported: resume.supported,
+        },
+      } as SavedUpload
+    } catch {
+      return undefined
+    }
+  }
+  save(record: SavedUpload) {
+    const existing = this.get(record.token)
+    // Preserve digests committed by another tab before this tab acquired its lock.
+    if (
+      existing &&
+      (!record.resume.uploadId ||
+        existing.resume.uploadId === record.resume.uploadId)
+    ) {
+      record = {
+        ...record,
+        confirmedBytes: Math.max(
+          record.confirmedBytes,
+          existing.confirmedBytes,
+        ),
+        resume: {
+          ...existing.resume,
+          ...record.resume,
+          uploadId: record.resume.uploadId ?? existing.resume.uploadId,
+          chunkSize: record.resume.chunkSize ?? existing.resume.chunkSize,
+          parts: { ...existing.resume.parts, ...record.resume.parts },
+        },
+      }
+    }
+    this.storage.setItem(this.prefix + record.token, JSON.stringify(record))
+  }
+  remove(token: string) {
+    this.storage.removeItem(this.prefix + token)
+  }
+}
+
+export const savedUpload = (
+  task: UploadTask,
+  target: UploadTarget,
+  lastModified: number,
+  fileName: string,
+  resume: MultipartResume,
+): SavedUpload => ({
+  version: 1,
+  token: resume.token,
+  name: task.name,
+  path: task.path,
+  directory: task.directory,
+  size: task.size,
+  lastModified,
+  fileName,
+  method: target.method,
+  asTask: target.asTask,
+  overwrite: target.overwrite,
+  rapid: target.rapid,
+  requiresPassword: task.requiresPassword,
+  confirmedBytes: task.confirmedBytes,
+  resume: { ...resume, parts: { ...resume.parts } },
+  updatedAt: Date.now(),
+})
