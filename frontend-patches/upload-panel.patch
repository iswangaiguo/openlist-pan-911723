+.upload-recovery-password {
+  display: block;
+  width: 100%;
+  box-sizing: border-box;
+  margin-top: 10px;
+  padding: 9px 10px;
+  color: var(--up-text);
+  background: var(--up-bg);
+  border: 1px solid var(--up-border);
+  border-radius: 6px;
+  font: inherit;
+}
+.upload-task[data-status="paused"] progress::-webkit-progress-value,
+.upload-task[data-status="needs_file"] progress::-webkit-progress-value {
+  background: #929292;
+}
+
+/* Dropbox-style task center; its fixed dock never changes the file layout. */
+.upload-center, .upload-center[data-mode="dark"] { --up-bg: #1e1919; --up-text: #f7f5f2; --up-muted: #b5b1ad; --up-border: #57534f; --up-soft: #34302e; width: 460px; border-radius: 20px; box-shadow: 0 10px 32px #0003; }
+.upload-center-header { padding: 20px 24px 12px; border: 0; gap: 10px; }
+.upload-center-header > div { flex: 1; min-width: 0; }
+.upload-center h2 { font-size: 22px; font-weight: 500; }
+.upload-center-header p { display: none; }
+.upload-center .upload-cancel-all { padding: 6px 10px; font-size: 12px; }
+.upload-center .upload-icon-button { margin-left: 0; flex-shrink: 0; }
+.upload-filters { display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 24px 18px; }
+.upload-center .upload-filters button { border-radius: 24px; border: 1px solid transparent; background: var(--up-soft); padding: 6px 10px; font-size: 12px; }
+.upload-center .upload-filters button[aria-pressed="true"] { border-color: #f7f5f2; background: #484440; }
+.upload-center-body { min-height: 230px; max-height: min(54dvh, 470px); }
+.upload-list-heading { padding: 8px 24px 16px; }
+.upload-task { margin: 0 24px; padding: 12px 0 18px 26px; position: relative; border-top: 0; }
+.upload-task-symbol { position: absolute; left: 0; top: 12px; font-size: 16px; color: var(--up-muted); }
+.upload-file-type { float: right; margin: 0 0 6px 8px; background: var(--up-soft); padding: 2px 5px; border-radius: 4px; color: var(--up-text); font-size: 10px; font-weight: 650; }
+.upload-task-top { gap: 6px; }
+.upload-task-top strong { font-weight: 600; }
+.upload-task-top > span { display: none; }
+.upload-task-status { gap: 8px; line-height: 1.6; align-items: flex-end; }
+.upload-task[data-status="success"] .upload-task-status { color: #83d0b2; }
+.upload-task[data-status="success"] progress, .upload-task[data-status="cancelled"] progress { display: none; }
+.upload-center .upload-row-action { color: var(--up-text); border-radius: 6px; background: var(--up-soft); padding: 5px 10px; margin: 0; }
+.upload-task-actions { gap: 8px; padding-top: 8px; }
+.upload-center-footer { margin: 12px; padding: 14px 12px; display: flex; align-items: center; gap: 12px; border: 0; border-radius: 12px; background: #0061ff; color: white; font-size: 13px; }
+.upload-center-footer[data-success="true"] { background: #217b5e; }
+.upload-mark { width: 42px; height: 42px; background: #0053d9; color: white; border-radius: 8px; font-size: 28px; }
+.upload-center-footer[data-success="true"] .upload-mark { background: #19694f; }
+.upload-summary-text { display: flex; flex: 1; flex-direction: column; gap: 3px; min-width: 0; }
+.upload-summary-text b { font-size: 14px; font-weight: 550; }
+.upload-summary-text small { font-size: 11px; opacity: .85; font-weight: 400; }
+.upload-center .upload-dock { padding: 12px; gap: 12px; min-height: 80px; background: var(--up-bg); }
+.upload-dock[data-success="true"] .upload-mark { background: #217b5e; }
+.upload-dock .upload-summary-text { font-weight: 400; }
+.upload-add-menu { position: relative; flex-shrink: 0; }
+.upload-add-menu summary { list-style: none; cursor: pointer; padding: 8px 10px; border: 1px solid #ffffff80; border-radius: 8px; }
+.upload-add-menu summary::-webkit-details-marker { display: none; }
+.upload-add-menu > div { position: absolute; right: 0; bottom: calc(100% + 8px); display: grid; width: 140px; padding: 6px; background: var(--up-soft); border: 1px solid var(--up-border); border-radius: 8px; z-index: 2; }
+.upload-add-menu button { text-align: left; border: 0; }
+.upload-empty { padding: 30px 24px; color: var(--up-muted); text-align: center; }
+@media (max-width: 600px) {
+  .upload-center { width: calc(100vw - 24px); }
+  .upload-center-header { padding: 16px 16px 8px; }
+  .upload-filters { padding: 12px 16px; gap: 6px; }
+  .upload-center-body { min-height: 180px; max-height: 48dvh; }
+  .upload-task { margin: 0 16px; }
+  .upload-center-footer { margin: 8px; gap: 8px; padding: 10px; }
+  .upload-summary-text b { font-size: 12px; }
+}
