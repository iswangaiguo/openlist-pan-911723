+/* A neutral layout control matching the file browser toolbar. */
+.drive-layout-trigger {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  width: 40px;
+  height: 40px;
+  padding: 0;
+  border: 0;
+  border-radius: 5px;
+  color: var(--drive-text);
+  background: transparent;
+}
+.drive-layout-trigger:hover,
+.drive-layout-trigger[aria-expanded="true"] {
+  background: var(--drive-hover);
+}
+.drive-layout-trigger svg {
+  width: 22px;
+  height: 22px;
+}
 .drive-layout-menu {
   min-width: 190px;
   border-radius: 14px;
