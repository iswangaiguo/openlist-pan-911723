--- /dev/null
+++ b/src/pages/home/folder/RowActions.tsx
@@ -0,0 +1,32 @@
+import { Icon } from "@hope-ui/solid"
+import { useContextMenu } from "solid-contextmenu"
+import { BsThreeDots } from "solid-icons/bs"
+import { usePath, useT } from "~/hooks"
+import { selectIndex } from "~/store"
+import type { StoreObj } from "~/types"
+
+// Both entry points use the same context menu and its existing operations.
+export const RowActions = (props: { obj: StoreObj; index: number }) => {
+  const t = useT()
+  const { setPathAs } = usePath()
+  const { show } = useContextMenu({ id: 1 })
+  return (
+    <div class="drive-row-actions" onMouseDown={(event) => event.stopPropagation()}>
+      <button
+        type="button"
+        class="drive-icon-button drive-row-menu"
+        aria-label={`${props.obj.name} · ${t("home.toolbar.more")}`}
+        title={t("home.toolbar.more")}
+        onClick={(event) => {
+          event.preventDefault()
+          event.stopPropagation()
+          selectIndex(props.index, true, true)
+          setPathAs(props.obj.name, props.obj.is_dir, true)
+          show(event, { props: props.obj })
+        }}
+      >
+        <Icon as={BsThreeDots} />
+      </button>
+    </div>
+  )
+}
