diff --git a/src/pages/home/DriveChrome.tsx b/src/pages/home/DriveChrome.tsx
new file mode 100644
index 0000000..089bb4f
--- /dev/null
+++ b/src/pages/home/DriveChrome.tsx
@@ -0,0 +1,167 @@
+import { Icon, Image, useColorModeValue } from "@hope-ui/solid"
+import { Show } from "solid-js"
+import {
+  BsFolder2,
+  BsShare,
+  BsArrowClockwise,
+  BsFolderPlus,
+  BsArrowUp,
+} from "solid-icons/bs"
+import { useRouter, usePath, useT } from "~/hooks"
+import { currentLang } from "~/app/i18n"
+import { getSetting, me, objStore, State, userCan } from "~/store"
+import { UserMethods } from "~/types"
+import { Layout } from "./header/layout"
+import { bus } from "~/utils"
+
+export const driveText = (key: "files" | "shares" | "workspace" | "waiting") => {
+  const zh = String(currentLang()).startsWith("zh")
+  return {
+    files: zh ? "所有文件" : "All files",
+    shares: zh ? "分享管理" : "Share management",
+    workspace: zh ? "文件空间" : "Workspace",
+    waiting: zh ? "等待传输" : "Waiting for transfer",
+  }[key]
+}
+
+export const DriveBrand = () => {
+  const { to } = useRouter()
+  const logos = getSetting("logo").split("\n")
+  const logo = useColorModeValue(logos[0], logos[1] || logos[0])
+  return (
+    <button
+      type="button"
+      class="drive-brand"
+      aria-label={String(currentLang()).startsWith("zh") ? "返回首页" : "Go home"}
+      onClick={() => to("/")}
+    >
+      <Show when={logo()} fallback={<span class="drive-brand-mark">O</span>}>
+        <Image
+          src={logo()}
+          alt=""
+          width="32px"
+          height="32px"
+          objectFit="contain"
+        />
+      </Show>
+      <span>{getSetting("site_title") || "OpenList"}</span>
+    </button>
+  )
+}
+
+export const DriveRail = () => {
+  const { to, isShare } = useRouter()
+  return (
+    <aside class="drive-rail" aria-label={driveText("workspace")}>
+      <DriveBrand />
+      <div class="drive-rail-label">{driveText("workspace")}</div>
+      <nav class="drive-rail-nav">
+        <Show when={!isShare()}>
+          <button
+            class="drive-nav-item drive-nav-current"
+            onClick={() => to("/")}
+          >
+            <Icon as={BsFolder2} />
+            <span>{driveText("files")}</span>
+          </button>
+        </Show>
+        <Show when={!isShare() && UserMethods.is_admin(me())}>
+          <button
+            type="button"
+            class="drive-nav-item"
+            onClick={() => to("/@manage/shares")}
+          >
+            <Icon as={BsShare} />
+            <span>{driveText("shares")}</span>
+          </button>
+        </Show>
+      </nav>
+    </aside>
+  )
+}
+
+export const DriveAccount = () => {
+  const t = useT()
+  const { to } = useRouter()
+  return (
+    <button
+      class="drive-account drive-desktop-account"
+      onClick={() => to(UserMethods.is_guest(me()) ? "/@login" : "/@manage")}
+    >
+      <span class="drive-avatar">
+        {(me().username || "O").slice(0, 1).toUpperCase()}
+      </span>
+      <span>
+        <strong>{me().username || "OpenList"}</strong>
+        <small>
+          {t(UserMethods.is_guest(me()) ? "login.login" : "home.footer.manage")}
+        </small>
+      </span>
+    </button>
+  )
+}
+
+export const DriveViewToolbar = () => (
+  <Show when={objStore.state === State.Folder}>
+    <div class="drive-view-toolbar">
+      <Layout />
+    </div>
+  </Show>
+)
+
+export const DriveHeading = () => {
+  const t = useT()
+  const { pathname, isShare } = useRouter()
+  const { refresh } = usePath()
+  const canWrite = () =>
+    objStore.state === State.Folder &&
+    !isShare() &&
+    (userCan("write_content") || objStore.write_content_bypass) &&
+    objStore.write
+  return (
+    <div class="drive-heading">
+      <div class="drive-heading-title">
+        <h1>
+          {pathname() === "/"
+            ? driveText("files")
+            : pathname().split("/").filter(Boolean).pop()}
+        </h1>
+      </div>
+      <div class="drive-actions">
+        <button
+          class="drive-icon-button drive-heading-refresh"
+          aria-label={t("home.toolbar.refresh")}
+          title={t("home.toolbar.refresh")}
+          onClick={() => refresh(undefined, true)}
+        >
+          <Icon as={BsArrowClockwise} />
+        </button>
+        <Show when={canWrite()}>
+          <button
+            class="drive-button drive-heading-mkdir"
+            aria-label={t("home.toolbar.mkdir")}
+            title={t("home.toolbar.mkdir")}
+            onClick={() => bus.emit("tool", "mkdir")}
+          >
+            <Icon as={BsFolderPlus} />
+            <span>{t("home.toolbar.mkdir")}</span>
+          </button>
+          <button
+            class="drive-button drive-button-primary drive-heading-upload"
+            aria-label={t("home.toolbar.upload")}
+            title={t("home.toolbar.upload")}
+            onClick={() => bus.emit("tool", "upload")}
+          >
+            <Icon as={BsArrowUp} />
+            <span>{t("home.toolbar.upload")}</span>
+          </button>
+        </Show>
+        <div class="drive-heading-layout">
+          <Show when={objStore.state === State.Folder}>
+            <Layout />
+          </Show>
+        </div>
+      </div>
+    </div>
+  )
+}
diff --git a/src/pages/home/DriveSelection.tsx b/src/pages/home/DriveSelection.tsx
new file mode 100644
index 0000000..1dd63f0
--- /dev/null
+++ b/src/pages/home/DriveSelection.tsx
@@ -0,0 +1,96 @@
+import { Icon } from "@hope-ui/solid"
+import { Show } from "solid-js"
+import { useContextMenu } from "solid-contextmenu"
+import { BsCheck2Square, BsDownload, BsThreeDots } from "solid-icons/bs"
+import { useDownload, useT } from "~/hooks"
+import {
+  checkboxOpen,
+  getSettingBool,
+  haveSelected,
+  me,
+  objStore,
+  selectedMsg,
+  selectedObjs,
+  selectAll,
+  State,
+  toggleCheckbox,
+  layout,
+} from "~/store"
+import { currentLang } from "~/app/i18n"
+import { bus, notify } from "~/utils"
+import { UserMethods } from "~/types"
+
+// Keep file operations alongside the list, and use the existing handlers.
+export const DriveSelection = () => {
+  const t = useT()
+  const { batchDownloadSelected } = useDownload()
+  const { show } = useContextMenu({ id: 1 })
+  const isFolder = () =>
+    [State.Folder, State.FetchingMore].includes(objStore.state)
+  const downloadSelected = () => {
+    if (selectedObjs().some((obj) => obj.is_dir)) {
+      if (!UserMethods.is_admin(me()) && !getSettingBool("package_download")) {
+        notify.warning(t("home.toolbar.package_download_disabled"))
+        return
+      }
+      bus.emit("tool", "package_download")
+      return
+    }
+    batchDownloadSelected()
+  }
+  const closeSelection = () => {
+    selectAll(false)
+    if (layout() !== "list" && checkboxOpen()) toggleCheckbox()
+  }
+  const selectLabel = () =>
+    String(currentLang()).startsWith("zh") ? "选择文件" : "Select files"
+  const hint = () =>
+    String(currentLang()).startsWith("zh")
+      ? "勾选文件后可下载或管理"
+      : "Select files to download or manage"
+  return (
+    <Show when={isFolder()}>
+      <div class="drive-file-tools" role="group" aria-label={selectLabel()}>
+        <Show when={haveSelected() || layout() !== "list"}>
+          <Show
+            when={haveSelected() || checkboxOpen()}
+            fallback={
+              <button class="drive-select-button" onClick={toggleCheckbox}>
+                <Icon as={BsCheck2Square} />
+                <span>{selectLabel()}</span>
+              </button>
+            }
+          >
+            <span class="drive-selection-count" role="status">
+              {haveSelected() ? selectedMsg() : hint()}
+            </span>
+            <div class="drive-selection-actions">
+              <Show when={haveSelected()}>
+                <button class="drive-button drive-selection-action" onClick={downloadSelected}>
+                  <Icon as={BsDownload} />
+                  <span>{t("home.toolbar.download")}</span>
+                </button>
+                <button
+                  type="button"
+                  class="drive-button drive-selection-action"
+                  aria-label={t("home.toolbar.more")}
+                  onClick={(event) => {
+                    event.preventDefault()
+                    event.stopPropagation()
+                    show(event, { props: selectedObjs()[0] })
+                  }}
+                >
+                  <Icon as={BsThreeDots} />
+                  <span>{t("home.toolbar.more")}</span>
+                </button>
+              </Show>
+              <button class="drive-select-button drive-selection-cancel" onClick={closeSelection}>
+                {t("home.toolbar.cancel_select")}
+              </button>
+            </div>
+          </Show>
+        </Show>
+      </div>
+    </Show>
+  )
+}
