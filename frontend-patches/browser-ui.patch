index 0000000..827b66f
--- /dev/null
+++ b/src/pages/home/drive.css
@@ -0,0 +1,944 @@
+/* File browser skin, scoped so management and login keep their own layouts. */
+.drive-shell {
+  --drive-bg: #fff;
+  --drive-rail: #f9fafd;
+  --drive-text: #1e1919;
+  --drive-muted: #706b67;
+  --drive-line: #e8e6e3;
+  --drive-hover: #f7f8fa;
+  --drive-blue: #0061ff;
+  --drive-selected: #eaf1ff;
+  width: 100%;
+  min-height: 100vh;
+  display: grid;
+  grid-template-columns: 228px minmax(0, 1fr);
+  color: var(--drive-text);
+  background: var(--drive-bg);
+  font-size: 14px;
+}
+.drive-shell[data-drive-mode="dark"] {
+  --drive-bg: #181a1e;
+  --drive-rail: #202227;
+  --drive-text: #f1f1f1;
+  --drive-muted: #adafb5;
+  --drive-line: #34373e;
+  --drive-hover: #24272e;
+  --drive-selected: #183354;
+  --drive-blue: #79abff;
+}
+.drive-shell button {
+  font: inherit;
+  cursor: pointer;
+}
+.drive-shell button:focus-visible {
+  outline: 3px solid #6da3ff;
+  outline-offset: 3px;
+}
+.drive-rail {
+  position: sticky;
+  top: 0;
+  height: 100vh;
+  padding: 32px 18px 20px;
+  display: flex;
+  flex-direction: column;
+  background: var(--drive-rail);
+  border-right: 1px solid var(--drive-line);
+}
+.drive-brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+  font-size: 18px;
+  font-weight: 700;
+  letter-spacing: -0.5px;
+  width: 100%;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+.drive-brand > span:last-child {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.drive-brand-mark {
+  width: 32px;
+  height: 32px;
+  display: grid;
+  place-items: center;
+  background: #0061ff;
+  color: white;
+  border-radius: 5px;
+  flex-shrink: 0;
+}
+.drive-rail .drive-brand {
+  padding: 0 10px;
+}
+.drive-rail-label {
+  margin: 48px 12px 12px;
+  color: var(--drive-muted);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 1px;
+  text-transform: uppercase;
+}
+.drive-rail-nav {
+  display: grid;
+  gap: 5px;
+}
+.drive-nav-item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  text-align: left;
+  width: 100%;
+  border: 0;
+  border-radius: 5px;
+  padding: 13px 12px;
+  color: var(--drive-text);
+  background: transparent;
+}
+.drive-nav-item svg {
+  width: 19px;
+  height: 19px;
+}
+.drive-nav-item:hover {
+  background: var(--drive-line);
+}
+.drive-nav-current {
+  background: var(--drive-selected);
+  color: var(--drive-blue);
+  font-weight: 600;
+}
+.drive-account {
+  margin-top: auto;
+  padding: 16px 8px 0;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  text-align: left;
+  border: 0;
+  border-top: 1px solid var(--drive-line);
+  background: transparent;
+  color: var(--drive-text);
+  min-width: 0;
+}
+.drive-account > span:last-child {
+  min-width: 0;
+}
+.drive-account strong {
+  display: block;
+  font-size: 13px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.drive-account small {
+  display: block;
+  margin-top: 3px;
+  color: var(--drive-muted);
+  font-size: 11px;
+}
+.drive-avatar {
+  width: 34px;
+  height: 34px;
+  flex-shrink: 0;
+  display: grid;
+  place-items: center;
+  background: #e4ded7;
+  color: #524a43;
+  border-radius: 50%;
+  font-weight: 600;
+}
+.drive-main {
+  min-width: 0;
+}
+.drive-shell .drive-container {
+  width: 100%;
+  max-width: 1440px;
+  margin-inline: auto;
+  padding-inline: 40px;
+}
+.drive-header {
+  background: var(--drive-bg);
+  border-bottom: 1px solid var(--drive-line);
+}
+.drive-header-inner {
+  height: 88px;
+  display: flex;
+  align-items: center;
+  gap: 20px;
+}
+.drive-search {
+  width: min(480px, 100%);
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  border: 1px solid var(--drive-line);
+  border-radius: 5px;
+  background: var(--drive-hover);
+  color: var(--drive-muted);
+  padding: 11px 14px;
+  text-align: left;
+}
+.drive-search:hover {
+  border-color: #b7c8e6;
+}
+.drive-search-shortcut {
+  margin-left: auto;
+  font-size: 11px;
+}
+.drive-header-tools {
+  margin-left: auto;
+  display: flex;
+  gap: 8px;
+  align-items: center;
+}
+.drive-header-tools > button {
+  border-radius: 5px;
+}
+
+.drive-shell .body {
+  padding: 30px 0 0;
+  min-height: calc(100vh - 160px);
+  gap: 20px;
+}
+.drive-shell .nav {
+  background: var(--drive-bg);
+  font-size: 12px;
+  color: var(--drive-muted);
+}
+.drive-shell .nav::after {
+  display: none;
+}
+.drive-shell .nav-link {
+  padding: 3px 0;
+  border-radius: 3px;
+}
+.drive-heading {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  margin: 2px 0 10px;
+}
+.drive-heading h1 {
+  font-size: 30px;
+  font-weight: 600;
+  line-height: 1.25;
+  letter-spacing: -0.8px;
+  overflow-wrap: anywhere;
+  margin: 0;
+}
+.drive-actions {
+  display: flex;
+  gap: 10px;
+  align-items: center;
+  flex-shrink: 0;
+}
+.drive-button,
