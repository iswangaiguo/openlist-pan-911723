diff --git a/src/pages/home/shares/ShareEditor.tsx b/src/pages/home/shares/ShareEditor.tsx
new file mode 100644
index 0000000..450f002
--- /dev/null
+++ b/src/pages/home/shares/ShareEditor.tsx
@@ -0,0 +1,351 @@
+import { Icon, ModalBody, ModalFooter, ModalHeader } from "@hope-ui/solid"
+import { createSignal, Show } from "solid-js"
+import { createStore } from "solid-js/store"
+import { BsFolder2 } from "solid-icons/bs"
+import { EnhancedFolderTree } from "~/components/EnhancedFolderTree"
+import {
+  Button,
+  Modal,
+  ModalContent,
+  ModalOverlay,
+} from "~/components/DriveDialog"
+import { useT } from "~/hooks"
+import { me } from "~/store"
+import {
+  ExtractFolder,
+  OrderBy,
+  OrderDirection,
+  Resp,
+  ShareInfo,
+} from "~/types"
+import { notify, pathJoin, r } from "~/utils"
+import { shareText } from "./shared"
+
+export const ShareEditor = (props: {
+  share?: ShareInfo
+  onClose: () => void
+  onSaved: () => void
+}) => {
+  const t = useT()
+  const [draft, setDraft] = createStore({
+    id: props.share?.id || "",
+    files: (props.share?.files || []).join("\n"),
+    remark: props.share?.remark || "",
+    pwd: props.share?.pwd || "",
+    max_accessed: props.share?.max_accessed || 0,
+    order_by: props.share?.order_by || OrderBy.None,
+    order_direction: props.share?.order_direction || OrderDirection.None,
+    extract_folder: props.share?.extract_folder || ExtractFolder.None,
+    readme: props.share?.readme || "",
+    header: props.share?.header || "",
+  })
+  const localDate = (value: string | null | undefined) => {
+    if (!value) return ""
+    const date = new Date(value)
+    if (!Number.isFinite(date.getTime())) return ""
+    date.setMinutes(date.getMinutes() - date.getTimezoneOffset())
+    return date.toISOString().slice(0, 16)
+  }
+  const [expires, setExpires] = createSignal(localDate(props.share?.expires))
+  const [saving, setSaving] = createSignal(false)
+  const [error, setError] = createSignal("")
+  const [picker, setPicker] = createSignal(false)
+  const [selected, setSelected] = createSignal("/")
+  const close = () => {
+    if (!saving()) props.onClose()
+  }
+
+  const save = async (event: SubmitEvent) => {
+    event.preventDefault()
+    if (saving()) return
+    setError("")
+    const files = [
+      ...new Set(
+        draft.files
+          .split("\n")
+          .map((p) => p.trim())
+          .filter(Boolean),
+      ),
+    ]
+    if (!files.length) return setError(shareText("files_required"))
+    const id = draft.id.trim()
+    if (id && !/^[a-zA-Z0-9_-]{1,64}$/.test(id))
+      return setError(shareText("id_invalid"))
+    if (!Number.isSafeInteger(draft.max_accessed) || draft.max_accessed < 0)
+      return setError(shareText("limit_invalid"))
+    const date = expires() ? new Date(expires()) : null
+    if (date && !Number.isFinite(date.getTime()))
+      return setError(shareText("expiry_invalid"))
+    setSaving(true)
+    try {
+      const resp: Resp<ShareInfo> = await r.post(
+        `/share/${props.share ? "update" : "create"}`,
+        {
+          ...draft,
+          id: props.share?.id || id,
+          ...(props.share ? { new_id: id || props.share.id } : {}),
+          files,
+          expires:
+            props.share && expires() === localDate(props.share.expires)
+              ? props.share.expires
+              : date?.toISOString() || null,
+        },
+      )
+      if (resp.code !== 200)
+        throw new Error(resp.message || shareText("save_error"))
+      notify.success(shareText("saved"))
+      props.onSaved()
+    } catch (error) {
+      setError(error instanceof Error ? error.message : shareText("save_error"))
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  return (
+    <>
+      <Modal opened onClose={close} size="lg">
+        <ModalOverlay />
+        <ModalContent class="drive-share-editor" data-drive-size="wide">
+          <ModalHeader>
+            {shareText(props.share ? "edit" : "create")}
+          </ModalHeader>
+          <ModalBody>
+            <form
+              id="drive-share-form"
+              class="drive-share-form"
+              onSubmit={save}
+            >
+              <fieldset disabled={saving()}>
+                <div class="drive-share-field">
+                  <label for="share-files">{shareText("files")} *</label>
+                  <div class="drive-share-path-field">
+                    <textarea
+                      id="share-files"
+                      rows="3"
+                      value={draft.files}
+                      onInput={(e) => setDraft("files", e.currentTarget.value)}
+                      aria-describedby="share-files-hint"
+                    />
+                    <button
+                      type="button"
+                      class="drive-button"
+                      aria-label={t("global.choose_or_input_path")}
+                      onClick={() => setPicker(true)}
+                    >
+                      <Icon as={BsFolder2} />
+                    </button>
+                  </div>
+                  <small id="share-files-hint">{shareText("files_hint")}</small>
+                </div>
+                <div class="drive-share-field">
+                  <label for="share-remark">{shareText("remark")}</label>
+                  <input
+                    id="share-remark"
+                    value={draft.remark}
+                    placeholder={shareText("optional")}
+                    onInput={(e) => setDraft("remark", e.currentTarget.value)}
+                  />
+                </div>
+                <div class="drive-share-form-grid">
+                  <div class="drive-share-field">
+                    <label for="share-password">{shareText("password")}</label>
+                    <input
+                      id="share-password"
+                      type="password"
+                      autocomplete="new-password"
+                      value={draft.pwd}
+                      placeholder={shareText("optional")}
+                      onInput={(e) => setDraft("pwd", e.currentTarget.value)}
+                    />
+                  </div>
+                  <div class="drive-share-field">
+                    <label for="share-expires">{shareText("expires")}</label>
+                    <input
+                      id="share-expires"
+                      type="datetime-local"
+                      value={expires()}
+                      onInput={(e) => setExpires(e.currentTarget.value)}
+                      aria-describedby="share-expiry-hint"
+                    />
+                    <small id="share-expiry-hint">
+                      {shareText("expiry_hint")}
+                    </small>
+                  </div>
+                </div>
+                <div class="drive-share-field">
+                  <label for="share-limit">{shareText("limit")}</label>
+                  <input
+                    id="share-limit"
+                    type="number"
+                    min="0"
+                    step="1"
+                    required
+                    value={draft.max_accessed}
+                    onInput={(e) =>
+                      setDraft("max_accessed", e.currentTarget.valueAsNumber)
+                    }
+                    aria-describedby="share-limit-hint"
+                  />
+                  <small id="share-limit-hint">{shareText("limit_hint")}</small>
+                </div>
+                <details class="drive-share-advanced">
+                  <summary>{shareText("advanced")}</summary>
+                  <div class="drive-share-field">
+                    <label for="share-id">{shareText("id")}</label>
+                    <input
+                      id="share-id"
+                      value={draft.id}
+                      maxlength="64"
+                      onInput={(e) => setDraft("id", e.currentTarget.value)}
+                      aria-describedby="share-id-hint"
+                    />
+                    <small id="share-id-hint">{shareText("id_hint")}</small>
+                  </div>
+                  <div class="drive-share-form-grid">
+                    <div class="drive-share-field">
+                      <label for="share-order">{t("shares.order_by")}</label>
+                      <select
+                        id="share-order"
+                        value={draft.order_by}
+                        onChange={(e) =>
+                          setDraft("order_by", e.currentTarget.value as OrderBy)
+                        }
+                      >
+                        <option value="">{shareText("default")}</option>
+                        <option value="name">
+                          {t("shares.order_bys.name")}
+                        </option>
+                        <option value="size">
+                          {t("shares.order_bys.size")}
+                        </option>
+                        <option value="modified">
+                          {t("shares.order_bys.modified")}
+                        </option>
+                      </select>
+                    </div>
+                    <div class="drive-share-field">
+                      <label for="share-direction">
+                        {t("shares.order_direction")}
+                      </label>
+                      <select
+                        id="share-direction"
+                        value={draft.order_direction}
+                        onChange={(e) =>
+                          setDraft(
+                            "order_direction",
+                            e.currentTarget.value as OrderDirection,
+                          )
+                        }
+                      >
+                        <option value="">{shareText("default")}</option>
+                        <option value="ASC">
+                          {t("shares.order_directions.asc")}
+                        </option>
+                        <option value="DESC">
+                          {t("shares.order_directions.desc")}
+                        </option>
+                      </select>
+                    </div>
+                  </div>
+                  <div class="drive-share-field">
+                    <label for="share-extract">
+                      {t("shares.extract_folder")}
+                    </label>
+                    <select
+                      id="share-extract"
+                      value={draft.extract_folder}
+                      onChange={(e) =>
+                        setDraft(
+                          "extract_folder",
+                          e.currentTarget.value as ExtractFolder,
+                        )
+                      }
+                    >
+                      <option value="">{shareText("default")}</option>
+                      <option value="front">
+                        {t("shares.extract_folders.front")}
+                      </option>
+                      <option value="back">
+                        {t("shares.extract_folders.back")}
+                      </option>
+                    </select>
+                  </div>
+                  <div class="drive-share-field">
+                    <label for="share-readme">{t("shares.readme")}</label>
+                    <textarea
+                      id="share-readme"
+                      rows="3"
+                      value={draft.readme}
+                      onInput={(e) => setDraft("readme", e.currentTarget.value)}
+                    />
+                  </div>
+                  <div class="drive-share-field">
+                    <label for="share-header">{t("shares.header")}</label>
+                    <textarea
+                      id="share-header"
+                      rows="3"
+                      value={draft.header}
+                      onInput={(e) => setDraft("header", e.currentTarget.value)}
+                    />
+                  </div>
+                </details>
+              </fieldset>
+              <Show when={error()}>
+                <p class="drive-share-error" role="alert">
+                  {error()}
+                </p>
+              </Show>
+            </form>
+          </ModalBody>
+          <ModalFooter>
+            <Button colorScheme="neutral" disabled={saving()} onClick={close}>
+              {shareText("cancel")}
+            </Button>
+            <Button
+              type="submit"
+              form="drive-share-form"
+              colorScheme="info"
+              loading={saving()}
+            >
+              {shareText(props.share ? "save" : "create")}
+            </Button>
+          </ModalFooter>
+        </ModalContent>
+      </Modal>
+      <Modal opened={picker()} onClose={() => setPicker(false)} size="lg">
+        <ModalOverlay />
+        <ModalContent data-drive-size="folder">
+          <ModalHeader>{t("global.choose_or_input_path")}</ModalHeader>
+          <ModalBody>
+            <EnhancedFolderTree
+              forceRoot
+              showHiddenFolder
+              onChange={setSelected}
+            />
+          </ModalBody>
+          <ModalFooter>
+            <Button colorScheme="neutral" onClick={() => setPicker(false)}>
+              {shareText("cancel")}
+            </Button>
+            <Button
+              colorScheme="info"
+              onClick={() => {
+                const paths = [
+                  ...new Set([
+                    ...draft.files.split("\n").filter(Boolean),
+                    pathJoin(me().base_path, selected()),
+                  ]),
+                ]
+                setDraft("files", paths.join("\n"))
+                setPicker(false)
+              }}
+            >
+              {t("shares.add_path")}
+            </Button>
+          </ModalFooter>
+        </ModalContent>
+      </Modal>
+    </>
+  )
+}
diff --git a/src/pages/home/shares/Shares.tsx b/src/pages/home/shares/Shares.tsx
new file mode 100644
index 0000000..a5cf810
--- /dev/null
+++ b/src/pages/home/shares/Shares.tsx
@@ -0,0 +1,481 @@
+import {
+  Icon,
+  Menu,
+  MenuContent,
+  MenuItem,
+  MenuTrigger,
+  ModalBody,
+  ModalFooter,
+  ModalHeader,
+  useColorModeValue,
+} from "@hope-ui/solid"
+import {
+  createMemo,
+  createSignal,
+  For,
+  onCleanup,
+  onMount,
+  Show,
+} from "solid-js"
+import {
+  BsArrowClockwise,
+  BsArrowLeft,
+  BsLink45deg,
+  BsPlusLg,
+  BsSearch,
+  BsThreeDots,
+} from "solid-icons/bs"
+import {
+  Button,
+  DriveDialogScope,
+  Modal,
+  ModalContent,
+  ModalOverlay,
+} from "~/components/DriveDialog"
+import { useRouter, useTitle, useUtil } from "~/hooks"
+import { me } from "~/store"
+import { PageResp, Resp, ShareInfo, UserMethods } from "~/types"
+import { notify, r } from "~/utils"
+import { Container } from "../Container"
+import { DriveAccount, driveText } from "../DriveChrome"
+import { ShareEditor } from "./ShareEditor"
+import { ShareStatus, shareStatus, shareText, shareUrl } from "./shared"
+import "./shares.css"
+
+const Shares = () => {
+  const { to } = useRouter()
+  const { copy } = useUtil()
+  const mode = useColorModeValue("light", "dark")
+  useTitle(shareText("title"))
+  const [shares, setShares] = createSignal<ShareInfo[]>([])
+  const [loading, setLoading] = createSignal(false)
+  const [error, setError] = createSignal("")
+  const [search, setSearch] = createSignal("")
+  const [filter, setFilter] = createSignal<"all" | ShareStatus>("all")
+  const [editor, setEditor] = createSignal<ShareInfo | null>()
+  const [deleting, setDeleting] = createSignal<ShareInfo>()
+  const [busy, setBusy] = createSignal("")
+  const [actionError, setActionError] = createSignal("")
+  const [now, setNow] = createSignal(Date.now())
+  let request: AbortController | undefined
+  let disposed = false
+  const refresh = async () => {
+    if (!UserMethods.is_admin(me())) return
+    request?.abort()
+    const controller = new AbortController()
+    request = controller
+    setLoading(true)
+    setError("")
+    try {
+      const resp: PageResp<ShareInfo> = await r.get("/share/list", {
+        signal: controller.signal,
+        timeout: 30000,
+      })
+      if (resp.code !== 200)
+        throw new Error(resp.message || shareText("load_error"))
+      if (!disposed && !controller.signal.aborted) {
+        setShares(resp.data.content || [])
+        setNow(Date.now())
+      }
+    } catch (error) {
+      if (!disposed && !controller.signal.aborted)
+        setError(
+          error instanceof Error ? error.message : shareText("load_error"),
+        )
+    } finally {
+      if (!disposed && request === controller) setLoading(false)
+    }
+  }
+  onMount(() => {
+    void refresh()
+    const timer = setInterval(() => setNow(Date.now()), 60000)
+    onCleanup(() => clearInterval(timer))
+  })
+  onCleanup(() => {
+    disposed = true
+    request?.abort()
+  })
+  const filtered = createMemo(() => {
+    const query = search().trim().toLocaleLowerCase()
+    return shares().filter(
+      (share) =>
+        (filter() === "all" || shareStatus(share, now()) === filter()) &&
+        (!query ||
+          [share.id, share.remark, share.creator, ...share.files]
+            .join(" ")
+            .toLocaleLowerCase()
+            .includes(query)),
+    )
+  })
+  const name = (share: ShareInfo) =>
+    share.remark || share.files[0]?.split("/").filter(Boolean).pop() || share.id
+  const date = (value: string | null) =>
+    value ? new Date(value).toLocaleString() : shareText("never")
+  const perform = async (
+    share: ShareInfo,
+    action: "enable" | "disable" | "delete",
+  ) => {
+    if (busy()) return
+    setBusy(share.id)
+    setActionError("")
+    try {
+      const resp: Resp<null> = await r.post(
+        `/share/${action}?id=${encodeURIComponent(share.id)}`,
+      )
+      if (resp.code !== 200)
+        throw new Error(resp.message || shareText("save_error"))
+      if (disposed) return
+      setShares((previous) =>
+        action === "delete"
+          ? previous.filter((item) => item.id !== share.id)
+          : previous.map((item) =>
+              item.id === share.id
+                ? { ...item, disabled: action === "disable" }
+                : item,
+            ),
+      )
+      setDeleting(undefined)
+      notify.success(
+        shareText(
+          action === "delete"
+            ? "deleted"
+            : action === "enable"
+              ? "enabled"
+              : "stopped",
+        ),
+      )
+      // Cancel an older list response so it cannot restore a deleted/disabled link.
+      void refresh()
+    } catch (error) {
+      if (!disposed)
+        setActionError(
+          error instanceof Error ? error.message : shareText("save_error"),
+        )
+    } finally {
+      if (!disposed) setBusy("")
+    }
+  }
+
+  return (
+    <DriveDialogScope>
+      <header class="drive-header">
+        <Container>
+          <div class="drive-header-inner">
+            <button
+              type="button"
+              class="drive-icon-button drive-shares-back"
+              aria-label={shareText("back")}
+              onClick={() => to("/")}
+            >
+              <Icon as={BsArrowLeft} />
+            </button>
+            <Show when={UserMethods.is_admin(me())}>
+              <label class="drive-search drive-shares-search">
+                <Icon as={BsSearch} />
+                <input
+                  type="search"
+                  aria-label={shareText("search")}
+                  placeholder={shareText("search")}
+                  value={search()}
+                  onInput={(e) => setSearch(e.currentTarget.value)}
+                />
+              </label>
+            </Show>
+            <div class="drive-header-tools">
+              <DriveAccount />
+            </div>
+          </div>
+        </Container>
+      </header>
+      <Container>
+        <section class="drive-shares" aria-labelledby="drive-shares-title">
+          <Show
+            when={UserMethods.is_admin(me())}
+            fallback={
+              <div class="drive-shares-empty">
+                <h1 id="drive-shares-title">{shareText("title")}</h1>
+                <p>{shareText("forbidden")}</p>
