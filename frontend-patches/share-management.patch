+}
+@media (max-width: 1100px) and (min-width: 761px) {
+  .drive-shares-table {
+    min-width: 760px;
+  }
+}
+@media (max-width: 760px) {
+  .drive-shares {
+    padding-top: 20px;
+  }
+  .drive-shares-back {
+    display: grid;
+    flex-shrink: 0;
+  }
+  .drive-shares-search {
+    max-width: none;
+  }
+  .drive-shares-search input {
+    font-size: 13px;
+  }
+  .drive-shares .drive-header-tools {
+    display: none;
+  }
+  .drive-shares-description {
+    max-width: 180px;
+    font-size: 12px;
+  }
+  .drive-shares .drive-actions {
+    flex-shrink: 0;
+  }
+  .drive-shares .drive-button-primary {
+    padding-inline: 10px;
+    font-size: 12px;
+  }
+  .drive-shares .drive-button-primary svg {
+    display: none;
+  }
+  .drive-shares-filters {
+    gap: 10px;
+    margin-top: 20px;
+  }
+  .drive-shares-filters nav {
+    gap: 16px;
+  }
+  .drive-shares-filters button {
+    font-size: 12px;
+  }
+  .drive-shares-table-wrap {
+    overflow: visible;
+  }
+  .drive-shares-table,
+  .drive-shares-table tbody {
+    display: block;
+  }
+  .drive-shares-table thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip-path: inset(50%);
+  }
+  .drive-shares-table tbody tr {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto;
+    gap: 12px;
+    padding: 20px 0;
+    border-bottom: 1px solid var(--drive-line);
+  }
+  .drive-shares-table td {
+    border: 0;
+    padding: 0;
+    font-size: 12px;
+  }
+  .drive-shares-table td:first-child {
+    grid-column: 1 / -1;
+  }
+  .drive-shares-name {
+    min-width: 0;
+  }
+  .drive-shares-name > div {
+    width: calc(100% - 54px);
+    max-width: none;
+  }
+  .drive-shares-table td:nth-child(2) {
+    grid-column: 1 / -1;
+  }
+  .drive-shares-table td:nth-child(3)::before,
+  .drive-shares-table td:nth-child(4)::before {
+    content: attr(data-label) ": ";
+    color: var(--drive-muted);
+  }
+  .drive-shares-table td:last-child {
+    grid-column: 1 / -1;
+  }
+  .drive-shares-row-actions {
+    justify-content: flex-start;
+  }
+  .drive-share-form-grid {
+    grid-template-columns: 1fr;
+    gap: 0;
+  }
+}
