+import { currentLang } from "~/app/i18n"
+import { ShareInfo } from "~/types"
+import { joinBase } from "~/utils"
+
+const labels = {
+  title: ["分享", "Shared"],
+  description: ["管理你创建的分享链接。", "Manage your shared links."],
+  create: ["新建分享", "Create share"],
+  edit: ["编辑分享", "Edit share"],
+  search: ["搜索文件、链接或备注", "Search files, links or notes"],
+  all: ["所有链接", "All links"],
+  active: ["有效", "Active"],
+  invalid: ["已失效", "Expired"],
+  disabled: ["已停用", "Disabled"],
+  link: ["分享链接", "Shared link"],
+  status: ["状态", "Status"],
+  expires: ["到期时间", "Expiration"],
+  accesses: ["访问次数", "Access count"],
+  operations: ["操作", "Actions"],
+  copy: ["复制链接", "Copy link"],
+  more: ["更多操作", "More actions"],
+  refresh: ["刷新", "Refresh"],
+  loading: ["正在加载分享…", "Loading shared links…"],
+  empty: ["还没有分享链接", "No shared links yet"],
+  empty_hint: [
+    "新建分享，或在所有文件中选择项目进行分享。",
+    "Create a share, or select items in All files to share them.",
+  ],
+  no_matches: ["没有找到匹配的分享", "No matching shares"],
+  clear: ["清除筛选", "Clear filters"],
+  load_error: [
+    "无法加载分享，请重试。",
+    "Unable to load shares. Please retry.",
+  ],
+  save_error: ["操作失败，请重试。", "Operation failed. Please retry."],
+  forbidden: [
+    "分享管理仅对管理员开放。",
+    "Share management is available to administrators.",
+  ],
+  back: ["返回所有文件", "Back to All files"],
+  never: ["长期有效", "Never"],
+  files: ["文件或文件夹", "Files or folders"],
+  files_hint: [
+    "每行一个完整路径，也可点击文件夹图标选择。",
+    "Enter one full path per line, or use the folder picker.",
+  ],
+  files_required: [
+    "请至少选择一个文件或文件夹。",
+    "Choose at least one file or folder.",
+  ],
+  id: ["自定义链接 ID", "Custom link ID"],
+  id_hint: [
+    "留空自动生成；可使用字母、数字、下划线和连字符。",
+    "Leave blank to generate; use letters, numbers, underscores and hyphens.",
+  ],
+  id_invalid: [
+    "链接 ID 只能使用字母、数字、下划线和连字符，最多 64 个字符。",
+    "Link IDs allow letters, numbers, underscores and hyphens, up to 64 characters.",
+  ],
+  remark: ["备注", "Note"],
+  password: ["访问密码", "Access password"],
+  optional: ["可选", "Optional"],
+  default: ["默认", "Default"],
+  expiry_hint: ["留空则长期有效。", "Leave blank for no expiration."],
+  expiry_invalid: ["请输入有效的到期时间。", "Enter a valid expiration time."],
+  limit: ["访问次数上限", "Access limit"],
+  limit_hint: ["0 表示不限次数。", "0 means unlimited."],
+  limit_invalid: [
+    "次数上限必须是大于或等于 0 的整数。",
+    "The access limit must be a non-negative integer.",
+  ],
+  advanced: ["更多设置", "Advanced settings"],
+  save: ["保存", "Save"],
+  cancel: ["取消", "Cancel"],
+  enable: ["启用", "Enable"],
+  disable: ["停用", "Disable"],
+  delete: ["删除", "Delete"],
+  delete_title: ["删除分享链接", "Delete shared link"],
+  delete_hint: [
+    "删除后，此分享链接将无法访问，原文件不会删除。",
+    "This link will stop working. The original files will remain.",
+  ],
+  saved: ["分享已保存", "Share saved"],
+  deleted: ["分享已删除", "Share deleted"],
+  enabled: ["分享已启用", "Share enabled"],
+  stopped: ["分享已停用", "Share disabled"],
+} as const
+
+export const shareText = (key: keyof typeof labels) =>
+  labels[key][String(currentLang()).startsWith("zh") ? 0 : 1]
+
+export type ShareStatus = "active" | "invalid" | "disabled"
+export function shareStatus(share: ShareInfo, now = Date.now()): ShareStatus {
+  if (share.disabled) return "disabled"
+  if (
+    !share.files.length ||
+    (share.max_accessed > 0 && share.accessed >= share.max_accessed) ||
+    (share.expires && new Date(share.expires).getTime() <= now)
+  )
+    return "invalid"
+  return "active"
+}
+
+export const shareUrl = (id: string) =>
+  `${location.origin}${joinBase("@s", encodeURIComponent(id))}`
