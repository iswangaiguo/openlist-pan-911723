--- /dev/null
+++ b/src/hooks/useDocumentIdentity.ts
@@ -0,0 +1,69 @@
+import { createEffect, createSignal, onCleanup, untrack } from "solid-js"
+import { me, objStore } from "~/store"
+import { fetchDocument } from "~/utils/document-cache"
+import { documentIdentity } from "~/utils/document-identity"
+import { useRouter } from "./useRouter"
+
+/** The cache identity of the file being previewed (see documentIdentity). */
+export const useDocumentIdentity = () => {
+  const { pathname } = useRouter()
+  return () => documentIdentity(me().id, pathname(), objStore.obj)
+}
+
+// Origins whose files cannot be read by script (no CORS): load them directly
+// instead of failing a cached download first on every file.
+const unreadable = new Set<string>()
+const originOf = (url: string) => {
+  try {
+    return new URL(url, location.href).origin
+  } catch {
+    return ""
+  }
+}
+
+/**
+ * A URL for an element such as <img>. Files opened before come from the
+ * document cache as an object URL; undefined while that is being resolved.
+ * Anything that cannot be cached keeps its original URL.
+ */
+export const useCachedUrl = (url: () => string) => {
+  const identity = useDocumentIdentity()
+  const [source, setSource] = createSignal<string>()
+  let objectUrl: string | undefined
+  const release = () => {
+    if (objectUrl) URL.revokeObjectURL(objectUrl)
+    objectUrl = undefined
+  }
+  createEffect(() => {
+    const target = url()
+    // Read with the URL it belongs to: the path changes before the file is
+    // loaded, and usePath stores the file's details before its URL.
+    const id = untrack(identity)
+    release()
+    if (!target || !id || unreadable.has(originOf(target))) {
+      setSource(target || undefined)
+      return
+    }
+    setSource(undefined)
+    // Leaving the file stops the download and keeps it out of the cache.
+    const loading = new AbortController()
+    onCleanup(() => loading.abort())
+    fetchDocument(target, id, loading.signal).then(
+      (blob) => {
+        if (loading.signal.aborted) return
+        objectUrl = URL.createObjectURL(blob)
+        setSource(objectUrl)
+      },
+      (error) => {
+        if (loading.signal.aborted) return
+        // A cross-origin network error is how a missing CORS policy shows up.
+        const origin = originOf(target)
+        if (error instanceof TypeError && origin !== location.origin)
+          unreadable.add(origin)
+        setSource(target)
+      },
+    )
+  })
+  onCleanup(release)
+  return source
+}
