diff --git a/src/utils/document-cache.ts b/src/utils/document-cache.ts
new file mode 100644
index 0000000..ce482a7
--- /dev/null
+++ b/src/utils/document-cache.ts
@@ -0,0 +1,60 @@
+import { joinBase } from "./path"
+import type { DocumentIdentity } from "./document-identity"
+
+// The storage is the module deployed with the PDF viewer
+// (scripts/pdf-range-cache.mjs in the Worker repository), so PDF ranges and
+// whole Office files share one IndexedDB store, one size limit and one cleanup.
+// Keep this path in sync with the viewer entry in previews/pdf.tsx.
+const MODULE = "static/pdfjs/6.3.289-openlist6/web/openlist-cache.mjs"
+
+interface DocumentCacheModule {
+  readDocument(key: string, size: number): Promise<Blob | null>
+  storeDocument(key: string, size: number, blob: Blob): Promise<boolean>
+  clearDocuments(): Promise<void>
+}
+
+let loading: Promise<DocumentCacheModule | undefined> | undefined
+// Browsers without module support, or a missing file, simply skip the cache.
+const load = () =>
+  (loading ??= import(
+    /* @vite-ignore */ new URL(joinBase(MODULE), location.origin).href
+  ).catch(() => undefined))
+
+/**
+ * Download a file for an in-page preview. A file opened before is read from
+ * the browser's cache; the cache never turns a working download into an error.
+ * What gets stored is always read from the network, not from the HTTP cache,
+ * so an older copy cannot be saved under the identity of a newer file.
+ */
+export async function fetchDocument(
+  url: string,
+  identity?: DocumentIdentity,
+  signal?: AbortSignal,
+): Promise<Blob> {
+  const cache = identity ? await load() : undefined
+  if (cache && identity) {
+    const hit = await cache
+      .readDocument(identity.key, identity.size)
+      .catch(() => null)
+    if (hit && !signal?.aborted) return hit
+  }
+  const response = await fetch(url, {
+    signal,
+    ...(identity ? { cache: "no-store" as const } : {}),
+  })
+  if (!response.ok) throw new Error("Failed to fetch document file")
+  const blob = await response.blob()
+  // A superseded request must not leave its bytes under this identity.
+  if (signal?.aborted) throw new DOMException("Aborted", "AbortError")
+  if (cache && identity)
+    void cache
+      .storeDocument(identity.key, identity.size, blob)
+      .catch(() => false)
+  return blob
+}
+
+/** Forget every cached document, e.g. when the account signs out. */
+export async function clearDocumentCache() {
+  const cache = await load()
+  await cache?.clearDocuments().catch(() => undefined)
+}
diff --git a/src/utils/document-identity.ts b/src/utils/document-identity.ts
new file mode 100644
index 0000000..799faf9
--- /dev/null
+++ b/src/utils/document-identity.ts
@@ -0,0 +1,28 @@
+/** Pure helper for the document cache (no imports, unit-testable). */
+
+export interface DocumentIdentity {
+  key: string
+  size: number
+}
+
+/**
+ * What tells one stored file from another: the account, the path, the size and
+ * the modification time. Replacing a file changes its identity, so cached
+ * bytes of the previous version are never read again. Signed URLs are not part
+ * of it because they change between visits.
+ */
+export function documentIdentity(
+  user: number | string | undefined,
+  path: string,
+  obj:
+    | { size?: number; modified?: string; is_dir?: boolean; archive?: unknown }
+    | undefined,
+): DocumentIdentity | undefined {
+  if (!obj || obj.is_dir || obj.archive || !path) return undefined
+  const size = obj.size
+  if (typeof size !== "number" || !Number.isSafeInteger(size) || size <= 0)
+    return undefined
+  // Storages without a real modification time cannot signal a replacement.
+  if (!obj.modified || !(Date.parse(obj.modified) > 0)) return undefined
+  return { key: [user ?? "", path, size, obj.modified].join("|"), size }
+}
