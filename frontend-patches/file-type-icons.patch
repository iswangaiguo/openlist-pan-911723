+import { IconProps, IconTemplate } from "solid-icons"
+
+const iconAttributes = (kind: string) => ({
+  viewBox: "0 0 32 32",
+  "aria-hidden": true as const,
+  "data-file-kind": kind,
+})
+
+// Local, multicolor SVGs keep file identity independent of the page accent.
+// Each type has a distinct symbol as well as a color, including at row sizes.
+function fileIcon(
+  kind: string,
+  ink: string,
+  paper: string,
+  fold: string,
+  symbol: string,
+) {
+  return (props: IconProps) =>
+    IconTemplate(
+      {
+        a: iconAttributes(kind),
+        c: `<path fill="${paper}" d="M8 2h11.5L27 9.5V28a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/>
+      <path fill="${fold}" d="M19.5 2v5.5a2 2 0 0 0 2 2H27Z"/>
+      <path stroke="${ink}" stroke-opacity=".25" stroke-width="1.5" stroke-linecap="round" d="M11 11.5h10M11 14.5h7"/>
+      <rect x="3" y="17" width="20" height="12" rx="2" fill="${ink}"/>
+      <g transform="translate(5 18.5)" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${symbol}</g>`,
+      },
+      props,
+    )
+}
+
+export const DriveFolderIcon = (props: IconProps) =>
+  IconTemplate(
+    {
+      a: iconAttributes("folder"),
+      c: `<path fill="#9ac8ff" d="M3 6h9l3 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z"/>
