diff --git a/src/utils/b2-jobs.ts b/src/utils/b2-jobs.ts
new file mode 100644
index 0000000..422e121
--- /dev/null
+++ b/src/utils/b2-jobs.ts
@@ -0,0 +1,35 @@
+import { r } from "./request"
+
+const active = new Map<string, Promise<void>>()
+
+/**
+ * Advance a B2 folder rename/move/copy job one bounded step per request until
+ * it finishes. Every caller watching the same job shares one poller; the
+ * server's lease keeps other tabs and the cron from doing the same step twice.
+ * Rejects when the job pauses (error.paused is true; the folder row shows it)
+ * or when a step fails, e.g. without write permission.
+ */
+export function driveB2Job(sourcePath: string): Promise<void> {
+  const running = active.get(sourcePath)
+  if (running) return running
+  const job = (async () => {
+    try {
+      while (true) {
+        const step: any = await r.post("/fs/rename/b2/step", {
+          path: sourcePath,
+        })
+        if (step.code !== 200 || !step.data) throw new Error(step.message)
+        if (step.data.done) return
+        if (step.data.state === "paused")
+          throw Object.assign(new Error(step.data.error || "B2 sync paused"), {
+            paused: true,
+          })
+        await new Promise((resolve) => setTimeout(resolve, 250))
+      }
+    } finally {
+      active.delete(sourcePath)
+    }
+  })()
+  active.set(sourcePath, job)
+  return job
+}
