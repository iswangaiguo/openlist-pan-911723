diff --git a/src/pages/home/header/MobileNavigation.tsx b/src/pages/home/header/MobileNavigation.tsx
new file mode 100644
index 0000000..19ef2fa
--- /dev/null
+++ b/src/pages/home/header/MobileNavigation.tsx
@@ -0,0 +1,92 @@
+import {
+  Drawer,
+  DrawerBody,
+  DrawerCloseButton,
+  DrawerContent,
+  DrawerHeader,
+  DrawerOverlay,
+  Icon,
+  createDisclosure,
+  useColorModeValue,
+} from "@hope-ui/solid"
+import { Show, createEffect, on, onCleanup, onMount } from "solid-js"
+import { BsArrowClockwise, BsList } from "solid-icons/bs"
+import { usePath, useRouter, useT } from "~/hooks"
+import { DriveBrand, DriveNavigation, driveText } from "../DriveChrome"
+
+export const MobileNavigation = () => {
+  const t = useT()
+  const { pathname } = useRouter()
+  const { refresh } = usePath()
+  const { isOpen, onOpen, onClose } = createDisclosure()
+  const mode = useColorModeValue("light", "dark")
+  const reducedMotion = window.matchMedia(
+    "(prefers-reduced-motion: reduce)",
+  ).matches
+
+  createEffect(on(pathname, onClose, { defer: true }))
+  onMount(() => {
+    const desktop = window.matchMedia("(min-width: 761px)")
+    const resized = () => {
+      if (desktop.matches) onClose()
+    }
+    desktop.addEventListener("change", resized)
+    onCleanup(() => desktop.removeEventListener("change", resized))
+  })
+
+  return (
+    <div class="drive-mobile-nav">
+      <button
+        type="button"
+        class="drive-icon-button drive-menu-button"
+        aria-label={driveText("workspace")}
+        aria-haspopup="dialog"
+        aria-expanded={isOpen()}
+        aria-controls={isOpen() ? "drive-mobile-navigation" : undefined}
+        onClick={onOpen}
+      >
+        <Icon as={BsList} />
+      </button>
+      {/* Hope's no-motion transition has no end event to release its portal. */}
+      <Show when={!reducedMotion || isOpen()}>
+        <Drawer
+          id="drive-mobile-navigation"
+          opened={isOpen()}
+          placement="left"
+          onClose={onClose}
+          disableMotion={reducedMotion}
+        >
+          <DrawerOverlay />
+          <DrawerContent
+            class="drive-mobile-drawer"
+            data-drive-mode={mode()}
+            aria-label={driveText("workspace")}
+          >
+            <DrawerCloseButton
+              class="drive-drawer-close"
+              aria-label={t("global.close")}
+            />
+            <DrawerHeader class="drive-drawer-header">
+              <DriveBrand onNavigate={onClose} />
+            </DrawerHeader>
+            <DrawerBody class="drive-drawer-body">
+              <div class="drive-rail-label">{driveText("workspace")}</div>
+              <DriveNavigation onNavigate={onClose} />
+              <button
+                type="button"
+                class="drive-nav-item drive-drawer-refresh"
+                onClick={() => {
+                  onClose()
+                  refresh(undefined, true)
+                }}
+              >
+                <Icon as={BsArrowClockwise} />
+                <span>{t("home.toolbar.refresh")}</span>
+              </button>
+            </DrawerBody>
+          </DrawerContent>
+        </Drawer>
+      </Show>
+    </div>
+  )
+}
