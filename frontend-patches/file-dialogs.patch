diff --git a/src/components/drive-dialog.css b/src/components/drive-dialog.css
new file mode 100644
index 0000000..d9e3bd8
--- /dev/null
+++ b/src/components/drive-dialog.css
@@ -0,0 +1,318 @@
+/* File-action dialogs are portaled outside .drive-shell. */
+.drive-dialog.hope-modal__content {
+  --drive-bg: #fff;
+  --drive-text: #1e1919;
+  --drive-muted: #706b67;
+  --drive-line: #e8e6e3;
+  --drive-hover: #f7f8fa;
+  --drive-blue: #0061ff;
+  --drive-selected: #eaf1ff;
+  --drive-dialog-width: 560px;
+  color-scheme: light;
+  width: calc(100vw - 32px);
+  max-width: var(--drive-dialog-width);
+  max-height: calc(100dvh - 48px);
+  margin-block: 24px;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  border: 1px solid var(--drive-line);
+  border-radius: 12px;
+  background: var(--drive-bg);
+  color: var(--drive-text);
+  box-shadow: 0 20px 64px rgb(30 25 25 / 20%);
+  font-size: 14px;
+  line-height: 1.5;
+}
+.drive-dialog[data-drive-mode="dark"] {
+  --drive-bg: #181a1e;
+  --drive-text: #f1f1f1;
+  --drive-muted: #adafb5;
+  --drive-line: #34373e;
+  --drive-hover: #24272e;
+  --drive-blue: #79abff;
+  --drive-selected: #183354;
+  color-scheme: dark;
+}
+.drive-dialog[data-drive-size="folder"] {
+  --drive-dialog-width: 640px;
+}
+.drive-dialog[data-drive-size="wide"] {
+  --drive-dialog-width: 800px;
+}
+.drive-dialog-overlay.hope-modal__overlay {
+  background: rgb(30 25 25 / 42%);
+  backdrop-filter: blur(2px);
+}
+.drive-dialog .hope-modal__header {
+  flex-shrink: 0;
+  padding: 24px 28px 20px;
+  border-bottom: 1px solid var(--drive-line);
+  color: var(--drive-text);
+  font-size: 21px;
+  font-weight: 600;
+  line-height: 1.35;
+  overflow-wrap: anywhere;
+}
+.drive-dialog .hope-modal__body {
+  min-height: 0;
+  padding: 24px 28px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+.drive-dialog .hope-modal__footer {
+  flex-shrink: 0;
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+  gap: 10px;
+  padding: 20px 28px;
+  border-top: 1px solid var(--drive-line);
+  background: var(--drive-bg);
+}
+.drive-dialog .hope-modal__close-button {
+  top: 20px;
+  right: 20px;
+  border-radius: 4px;
+  color: var(--drive-muted);
+}
+.drive-dialog .hope-modal__close-button:hover {
+  background: var(--drive-hover);
+  color: var(--drive-text);
+}
+.drive-dialog .hope-button {
+  min-height: 36px;
+  border-radius: 4px;
+  font-size: 14px;
+  font-weight: 600;
+}
+.drive-dialog .hope-button[data-drive-tone] {
+  padding-inline: 16px;
+  border: 1px solid transparent;
+  background: #0061ff;
+  color: #fff;
+}
+.drive-dialog .hope-button[data-drive-tone]:hover:not(:disabled) {
+  background: #0052d9;
+}
+.drive-dialog .hope-button[data-drive-tone="neutral"],
+.drive-dialog .hope-button[data-drive-variant="outline"],
+.drive-dialog .hope-button[data-drive-variant="ghost"] {
+  border-color: var(--drive-line);
+  background: var(--drive-bg);
+  color: var(--drive-text);
+}
+.drive-dialog .hope-button[data-drive-tone="neutral"]:hover:not(:disabled),
+.drive-dialog .hope-button[data-drive-variant="outline"]:hover:not(:disabled),
+.drive-dialog .hope-button[data-drive-variant="ghost"]:hover:not(:disabled) {
+  background: var(--drive-hover);
+}
+.drive-dialog .hope-button[data-drive-tone="danger"] {
+  background: #c92a2a;
+}
+.drive-dialog .hope-button[data-drive-tone="danger"]:hover:not(:disabled) {
+  background: #ad2020;
+}
+.drive-dialog .hope-button:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+.drive-dialog :is(button, input, textarea, [tabindex]):focus-visible {
+  outline: 2px solid var(--drive-blue);
+  outline-offset: 3px;
+}
+.drive-dialog
+  :is(.hope-input, .hope-textarea, .hope-select__trigger, .drive-share-input) {
+  min-height: 40px;
+  padding: 9px 12px;
+  border: 1px solid var(--drive-line);
+  border-radius: 4px;
+  background: var(--drive-bg);
+  color: var(--drive-text);
+  font-size: 14px;
+}
+.drive-dialog
+  :is(
+    .hope-input,
+    .hope-textarea,
+    .hope-select__trigger,
+    .drive-share-input
+  ):focus {
+  border-color: var(--drive-blue);
+}
+.drive-dialog :is(.hope-input, .hope-textarea)[aria-invalid="true"] {
+  border-color: #c92a2a;
+}
+.drive-dialog :is(.hope-input, .hope-textarea)::placeholder {
+  color: var(--drive-muted);
+}
+.drive-dialog
+  :is(.hope-checkbox__label, .hope-radio__label, .hope-form-helper-text) {
+  font-size: 13px;
+}
+.drive-dialog :is(.hope-checkbox__control, .hope-radio__control)[data-checked] {
+  background: #0061ff;
+  border-color: #0061ff;
+  color: #fff;
+}
+.drive-dialog .drive-folder-path {
+  display: block;
+  margin-bottom: 16px;
+  padding: 10px 12px;
+  border: 1px solid var(--drive-line);
+  border-radius: 4px;
+  background: var(--drive-hover);
+  color: var(--drive-muted);
+  overflow-wrap: anywhere;
+  font-size: 13px;
+}
+.drive-dialog .folder-tree-box {
+  min-height: 180px;
+  max-height: 300px;
+  padding: 8px;
+  border: 1px solid var(--drive-line);
+  border-radius: 4px;
+  overflow: auto;
+}
+.drive-dialog .drive-folder-row {
+  min-height: 36px;
+  padding-inline: 8px;
+  border-radius: 4px;
+}
+.drive-dialog .drive-folder-row:hover {
+  background: var(--drive-hover);
+}
+.drive-dialog .drive-folder-row[data-selected="true"] {
+  background: var(--drive-selected);
+  color: var(--drive-blue);
+}
+.drive-dialog .drive-folder-row .hope-text,
+.drive-dialog .drive-folder-row .hope-text:hover {
+  padding-block: 4px;
+  background: transparent;
+  color: inherit;
+  font-size: 14px;
+}
+.drive-dialog .drive-folder-row .hope-icon {
+  color: var(--drive-blue);
+}
+.drive-dialog .drive-folder-footer {
+  align-items: stretch;
+}
+.drive-dialog .drive-folder-options {
+  flex-basis: 100%;
+  margin: 0 0 6px;
+  padding-bottom: 16px;
+  border-bottom: 1px solid var(--drive-line);
+}
+.drive-dialog .drive-folder-buttons {
+  margin-left: auto;
+}
+.drive-dialog .drive-share-target {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  min-width: 0;
+  padding-bottom: 24px;
+  border-bottom: 1px solid var(--drive-line);
+}
+.drive-dialog .drive-share-target-icon {
+  display: grid;
+  place-items: center;
+  width: 42px;
+  height: 42px;
+  flex: 0 0 42px;
+  color: var(--drive-blue);
+  background: var(--drive-selected);
+  border-radius: 4px;
+  font-size: 24px;
+}
+.drive-dialog .drive-share-target > div {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  gap: 3px;
+}
+.drive-dialog .drive-share-target strong {
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  font-size: 15px;
+}
+.drive-dialog
+  :is(
+    .drive-share-target span:last-child,
+    .drive-share-setting span,
+    .drive-share-result p
+  ) {
+  color: var(--drive-muted);
+  font-size: 13px;
+}
+.drive-dialog .drive-share-section-title {
+  font-size: 14px;
+  font-weight: 600;
+  margin: 22px 0 4px;
+}
+.drive-dialog .drive-share-setting {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  min-height: 68px;
+  border-bottom: 1px solid var(--drive-line);
+}
+.drive-dialog .drive-share-setting > div {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+.drive-dialog .drive-share-setting strong {
+  font-size: 14px;
+  font-weight: 550;
+}
+.drive-dialog .drive-share-setting input[type="checkbox"] {
+  width: 19px;
+  height: 19px;
+  accent-color: #0061ff;
+  cursor: pointer;
+  flex: none;
+}
+.drive-dialog .drive-share-input {
+  width: 100%;
+  margin: 10px 0;
+}
+.drive-dialog .drive-share-setting + input:not([type="checkbox"]) {
+  margin-top: 10px;
+}
+.drive-dialog .drive-share-result {
+  padding: 24px 0 4px;
+}
+.drive-dialog .drive-share-result label {
+  display: block;
+  margin-bottom: 9px;
+  font-weight: 600;
+}
+.drive-dialog .drive-share-result p {
+  margin: 10px 0 0;
+}
+@media (max-width: 600px) {
+  .drive-dialog.hope-modal__content {
+    width: calc(100vw - 24px);
+    max-height: calc(100dvh - 24px);
+    margin-block: 12px;
+  }
+  .drive-dialog .hope-modal__header {
+    padding: 20px;
+    font-size: 19px;
+  }
+  .drive-dialog .hope-modal__body {
+    padding: 20px;
+  }
+  .drive-dialog .hope-modal__footer {
+    padding: 16px 20px;
+  }
+  .drive-dialog .hope-modal__header > .hope-stack {
+    flex-wrap: wrap;
+    gap: 12px;
+  }
+}
