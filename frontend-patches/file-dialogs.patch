diff --git a/src/components/DriveDialog.tsx b/src/components/DriveDialog.tsx
new file mode 100644
index 0000000..f38b2cc
--- /dev/null
+++ b/src/components/DriveDialog.tsx
@@ -0,0 +1,65 @@
+import {
+  Button as HopeButton,
+  Modal as HopeModal,
+  ModalContent as HopeModalContent,
+  ModalOverlay as HopeModalOverlay,
+  useColorMode,
+} from "@hope-ui/solid"
+import { ComponentProps, createContext, JSX, useContext } from "solid-js"
+import "./drive-dialog.css"
+
+// Solid context follows both toolbar and nested folder-picker portals.
+// Shared inputs keep their original appearance outside the file browser.
+const DriveDialogContext = createContext(false)
+
+export const DriveDialogScope = (props: { children: JSX.Element }) => (
+  <DriveDialogContext.Provider value={true}>
+    {props.children}
+  </DriveDialogContext.Provider>
+)
+
+export const useDriveDialog = () => useContext(DriveDialogContext)
+
+export const Modal = (props: ComponentProps<typeof HopeModal>) => {
+  const drive = useDriveDialog()
+  return <HopeModal {...props} centered={drive ? true : props.centered} />
+}
+
+export const ModalContent = (
+  props: ComponentProps<typeof HopeModalContent>,
+) => {
+  const drive = useDriveDialog()
+  const { colorMode } = useColorMode()
+  return (
+    <HopeModalContent
+      {...props}
+      class={[props.class, drive && "drive-dialog"].filter(Boolean).join(" ")}
+      data-drive-mode={drive ? colorMode() : undefined}
+    />
+  )
+}
+
+export const ModalOverlay = (
+  props: ComponentProps<typeof HopeModalOverlay>,
+) => {
+  const drive = useDriveDialog()
+  return (
+    <HopeModalOverlay
+      {...props}
+      class={[props.class, drive && "drive-dialog-overlay"]
+        .filter(Boolean)
+        .join(" ")}
+    />
+  )
+}
+
+export const Button = (props: ComponentProps<typeof HopeButton>) => {
+  const drive = useDriveDialog()
+  return (
+    <HopeButton
+      {...props}
+      data-drive-tone={drive ? props.colorScheme || "info" : undefined}
+      data-drive-variant={drive ? props.variant : undefined}
+    />
+  )
+}
