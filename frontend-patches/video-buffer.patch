diff --git a/src/pages/home/previews/video_buffer.ts b/src/pages/home/previews/video_buffer.ts
new file mode 100644
index 0000000..9cb3441
--- /dev/null
+++ b/src/pages/home/previews/video_buffer.ts
@@ -0,0 +1,12 @@
+// Keep more media ready ahead of playback on slower connections. The browser
+// may still evict buffered media when memory is limited.
+export const hlsBufferConfig = {
+  maxBufferLength: 120,
+  maxBufferSize: 120 * 1000 * 1000,
+}
+
+export const mpegtsBufferConfig = {
+  referrerPolicy: "same-origin" as const,
+  lazyLoadMaxDuration: 300,
+  lazyLoadRecoverDuration: 60,
+}
