--- /dev/null
+++ b/src/pages/login/login.css
@@ -0,0 +1,389 @@
+.login-workspace {
+  --login-bg: #fff;
+  --login-text: #1e1919;
+  --login-muted: #736c64;
+  --login-line: #dedbd7;
+  --login-hover: #f7f5f2;
+  --login-blue: #0061ff;
+  width: 100%;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(440px, 1fr);
+  min-height: 100vh;
+  min-height: 100dvh;
+  background: var(--login-bg);
+  color: var(--login-text);
+}
+.login-workspace[data-login-mode="dark"] {
+  --login-bg: #181a1e;
+  --login-text: #f1f1f1;
+  --login-muted: #b4b0ab;
+  --login-line: #45474c;
+  --login-hover: #24272e;
+  --login-blue: #8ab5ff;
+}
+.login-story {
+  display: flex;
+  flex-direction: column;
+  padding: 40px 48px 32px;
+  background: #063bce;
+  color: #fff;
+  overflow: hidden;
+}
+.login-brand {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  font-size: 20px;
+  font-weight: 650;
+  overflow-wrap: anywhere;
+}
+.login-brand-mark {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  flex-shrink: 0;
+  background: #fff;
+  color: #0061ff;
+  border-radius: 6px;
+  font-size: 22px;
+}
+.login-story-content {
+  margin: auto 0;
+  padding-block: 56px 32px;
+  max-width: 540px;
+}
+.login-eyebrow {
+  font-size: 11px;
+  letter-spacing: 0.12em;
+  font-weight: 600;
+  margin: 0 0 18px;
+  line-height: 1.5;
+}
+.login-story .login-eyebrow {
+  color: #c7d8ff;
+}
+.login-story h2 {
+  font-size: clamp(32px, 3.4vw, 56px);
+  line-height: 1.15;
+  letter-spacing: -0.04em;
+  font-weight: 600;
+  margin: 0;
+}
+.login-story-description {
+  max-width: 380px;
+  color: #d6e2ff;
+  font-size: 15px;
+  line-height: 1.8;
+  margin: 24px 0 0;
+}
+.login-story-footer {
+  margin: 0;
+  color: #c7d8ff;
+  font-size: 12px;
+}
+.login-art {
+  position: relative;
+  height: 220px;
+  width: min(100%, 380px);
+  margin: 48px auto 0;
+}
+.login-art-sheet {
+  position: absolute;
+  left: 28%;
+  top: 8px;
+  width: 140px;
+  height: 165px;
+  padding: 30px 22px;
+  background: #f8f5ec;
+  transform: rotate(10deg);
+  border-radius: 3px;
+}
+.login-art-sheet span {
+  display: block;
+  height: 5px;
+  background: #bdd0f2;
+  margin-bottom: 13px;
+}
+.login-art-sheet span:last-child {
+  width: 60%;
+}
+.login-art-folder {
+  position: absolute;
+  top: 68px;
+  left: 10%;
+  width: 72%;
+  height: 145px;
+  transform: rotate(-7deg);
+}
+.login-art-folder-tab {
+  width: 44%;
+  height: 25px;
+  border-radius: 7px 12px 0 0;
+  background: #9ac3ff;
+}
+.login-art-folder-face {
+  position: absolute;
+  inset: 20px 0 0;
+  display: flex;
+  align-items: flex-end;
+  padding: 20px;
+  background: #b6d7ff;
+  border-radius: 0 6px 6px 6px;
+  color: #063bce;
+  font-size: 34px;
+  font-weight: 650;
+}
+.login-art-note {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  width: 88px;
+  height: 88px;
+  background: #ffe1a2;
+  padding: 26px 18px;
+  transform: rotate(12deg);
+}
+.login-art-note span {
+  display: block;
+  height: 4px;
+  margin-bottom: 12px;
+  background: #bf8c35;
+}
+.login-art-note span:last-child {
+  width: 60%;
+}
+.login-panel {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  padding: 28px 48px 24px;
+}
+.login-panel-header {
+  display: flex;
+  justify-content: flex-end;
+  align-items: center;
+  min-height: 40px;
+  gap: 16px;
+}
+.login-mobile-brand {
+  display: none;
+}
+.login-preferences {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  color: var(--login-muted);
+}
+.login-preferences svg {
+  color: var(--login-muted);
+}
+.login-form-wrap {
+  width: 100%;
+  max-width: 368px;
+  margin: auto;
+  padding-block: 48px;
+}
+.login-form-wrap .login-eyebrow {
+  color: var(--login-muted);
+  margin-bottom: 12px;
+}
+.login-form-wrap h1 {
+  font-size: 30px;
+  line-height: 1.3;
+  font-weight: 600;
+  letter-spacing: -0.035em;
+  margin: 0;
+}
+.login-intro {
+  color: var(--login-muted);
+  font-size: 14px;
+  line-height: 1.6;
+  margin: 12px 0 30px;
+}
+.login-form {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
+.login-field {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.login-field label {
+  font-size: 13px;
+  font-weight: 600;
+}
+.login-field .hope-input {
+  height: 48px;
+  border: 1px solid var(--login-line);
+  border-radius: 5px;
+  background: var(--login-bg);
+  color: var(--login-text);
+  font-size: 16px;
+  padding-inline: 12px;
+  box-shadow: none;
+}
+.login-field .hope-input::placeholder {
+  color: var(--login-muted);
+  font-size: 13px;
+}
+.login-field .hope-input:focus {
+  border-color: var(--login-blue);
+  box-shadow: 0 0 0 1px var(--login-blue);
+}
+.login-options {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+  font-size: 12px;
+}
+.login-options .hope-checkbox__label,
+.login-ldap .hope-checkbox__label {
+  font-size: 12px;
+  color: var(--login-muted);
+}
+.login-options a {
+  color: var(--login-text);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+.login-workspace .login-submit {
+  height: 48px;
+  background: #0061ff;
+  color: #fff;
+  border-radius: 5px;
+  font-size: 14px;
+  font-weight: 600;
+}
+.login-workspace .login-submit:hover {
+  background: #0052d9;
+}
+.login-clear {
+  align-self: center;
+  border: 0;
+  background: transparent;
+  color: var(--login-muted);
+  cursor: pointer;
+  font: inherit;
+  font-size: 12px;
+  padding: 4px 12px;
+  margin-top: -8px;
+}
+.login-clear:hover {
+  color: var(--login-text);
+  text-decoration: underline;
+}
+.login-alternatives {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  border-top: 1px solid var(--login-line);
+  margin-top: 24px;
+  padding-top: 24px;
+}
+.login-alternative {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  min-height: 44px;
+  width: 100%;
+  border: 1px solid var(--login-line);
+  border-radius: 5px;
+  background: var(--login-bg);
+  color: var(--login-text);
+  font: inherit;
+  font-size: 13px;
+  cursor: pointer;
+  padding: 10px 12px;
+}
+.login-alternative:hover {
+  background: var(--login-hover);
+}
+.login-alternative svg {
+  width: 20px;
+  height: 20px;
+  flex-shrink: 0;
+}
+.login-guest {
+  min-height: 40px;
+  border: 0;
+  background: transparent;
+  color: var(--login-muted);
+  font: inherit;
+  font-size: 13px;
+  cursor: pointer;
+}
+.login-guest:hover {
+  color: var(--login-blue);
+}
+.login-workspace button:focus-visible,
+.login-workspace a:focus-visible {
+  outline: 2px solid var(--login-blue);
+  outline-offset: 4px;
+}
+.login-panel-footer {
+  text-align: center;
+  color: var(--login-muted);
+  font-size: 11px;
+  overflow-wrap: anywhere;
+}
