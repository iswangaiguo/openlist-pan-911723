diff --git a/src/pages/home/previews/video_seek.ts b/src/pages/home/previews/video_seek.ts
new file mode 100644
index 0000000..b428f89
--- /dev/null
+++ b/src/pages/home/previews/video_seek.ts
@@ -0,0 +1,112 @@
+type ProgressPlayer = {
+  duration: number
+  played: number
+  seek: number
+  isFocus: boolean
+  isInput: boolean
+  template: { $progress: HTMLElement; $player: HTMLElement }
+  emit: {
+    (
+      name: "setBar",
+      type: "played" | "hover",
+      value: number,
+      event?: MouseEvent,
+    ): void
+    (name: "focus", event: MouseEvent): void
+  }
+  on: (
+    name: "setBar",
+    callback: (type: string, value: number, event?: Event) => void,
+  ) => void
+  off: (
+    name: "setBar",
+    callback: (type: string, value: number, event?: Event) => void,
+  ) => void
+}
+
+// ArtPlayer seeks on every mousemove. For remote files, preview the destination
+// while dragging and commit once on release to avoid reading intermediate ranges.
+export function installCommittedVideoSeek(player: ProgressPlayer) {
+  const { $progress, $player } = player.template
+  if ($player.classList.contains("art-mobile")) return () => {}
+  let dragging = false,
+    suppressClick = false
+  let destination = 0,
+    lastEvent: MouseEvent | undefined
+  const preview = (event: MouseEvent) => {
+    const rect = $progress.getBoundingClientRect()
+    if (
+      !rect.width ||
+      !Number.isFinite(player.duration) ||
+      player.duration <= 0
+    )
+      return
+    const fraction = Math.min(
+      1,
+      Math.max(0, (event.clientX - rect.left) / rect.width),
+    )
+    destination = fraction * player.duration
+    lastEvent = event
+    player.emit("setBar", "played", fraction, event)
+    player.emit("setBar", "hover", fraction, event)
+  }
+  const begin = (event: MouseEvent) => {
+    if (
+      event.button !== 0 ||
+      !Number.isFinite(player.duration) ||
+      player.duration <= 0
+    )
+      return
+    // Prevent the built-in progress handler from arming its repeated seeks.
+    event.stopImmediatePropagation()
+    event.preventDefault()
+    dragging = true
+    suppressClick = false
+    player.isFocus = true
+    player.isInput = false
+    player.emit("focus", event)
+    preview(event)
+  }
+  const move = (event: MouseEvent) => {
+    if (dragging) preview(event)
+  }
+  const release = (event: MouseEvent) => {
+    if (!dragging || event.button !== 0) return
+    preview(event)
+    dragging = false
+    suppressClick = true
+    player.seek = destination
+  }
+  const click = (event: MouseEvent) => {
+    if (!suppressClick || event.button !== 0) return
+    suppressClick = false
+    event.stopImmediatePropagation()
+    event.preventDefault()
+  }
+  const repaint = (type: string, _value: number, event?: Event) => {
+    // Playback can continue while dragging; its timeupdate must not move the
+    // preview back to the old position. The event guard avoids recursive emits.
+    if (dragging && type === "played" && !event && lastEvent)
+      player.emit("setBar", "played", destination / player.duration, lastEvent)
+  }
+  const cancel = () => {
+    suppressClick ||= dragging
+    dragging = false
+    player.emit("setBar", "played", player.played)
+  }
+  $progress.addEventListener("mousedown", begin, true)
+  $progress.addEventListener("click", click, true)
+  document.addEventListener("mousemove", move, true)
+  document.addEventListener("mouseup", release, true)
+  window.addEventListener("blur", cancel)
+  player.on("setBar", repaint)
+  return () => {
+    dragging = suppressClick = false
+    $progress.removeEventListener("mousedown", begin, true)
+    $progress.removeEventListener("click", click, true)
+    document.removeEventListener("mousemove", move, true)
+    document.removeEventListener("mouseup", release, true)
+    window.removeEventListener("blur", cancel)
+    player.off("setBar", repaint)
+  }
+}
diff --git a/src/pages/home/previews/video_wake.ts b/src/pages/home/previews/video_wake.ts
new file mode 100644
index 0000000..364abeb
--- /dev/null
+++ b/src/pages/home/previews/video_wake.ts
@@ -0,0 +1,109 @@
+// A background/suspended page may keep a dead media request without emitting an
+// error. Allow one recovery only after a real resume/long interruption and a
+// further 15 seconds without playback/seek progress. Ordinary buffering and
+// focus changes never reload the source.
+export function installVideoWakeRecovery(
+  video: HTMLVideoElement,
+  recover: (resume: boolean) => void,
+) {
+  let disposed = false,
+    wakeAt = 0,
+    blockedAt = 0
+  let hiddenAt: number | undefined = document.hidden ? Date.now() : undefined
+  let frozen = false,
+    offline = false,
+    lastTick = Date.now(),
+    position = video.currentTime
+  let timer: ReturnType<typeof setTimeout>
+  const arm = () => {
+    if (!wakeAt || Date.now() - wakeAt > 120_000) {
+      wakeAt = Date.now()
+      blockedAt = 0
+      position = video.currentTime
+    }
+    lastTick = Date.now()
+  }
+  const clear = () => {
+    wakeAt = blockedAt = 0
+    position = video.currentTime
+  }
+  const visibility = () => {
+    if (document.hidden) {
+      hiddenAt = Date.now()
+      clear()
+    } else if (hiddenAt !== undefined) {
+      if (Date.now() - hiddenAt >= 60_000) arm()
+      hiddenAt = undefined
+    }
+  }
+  const freeze = () => {
+    frozen = true
+    clear()
+  }
+  const resume = () => {
+    if (frozen) {
+      frozen = false
+      arm()
+    }
+  }
+  const pageShow = (event: PageTransitionEvent) => {
+    if (event.persisted) arm()
+  }
+  const focus = () => {
+    if (Date.now() - lastTick >= 60_000) arm()
+  }
+  const wentOffline = () => {
+    offline = true
+  }
+  const online = () => {
+    if (offline) {
+      offline = false
+      arm()
+    }
+  }
+  const tick = () => {
+    if (disposed) return
+    const now = Date.now()
+    if (!document.hidden && now - lastTick >= 60_000) arm()
+    lastTick = now
+    if (!document.hidden && wakeAt) {
+      if (now - wakeAt > 120_000 || video.ended) clear()
+      else if (video.paused && !video.seeking) {
+        blockedAt = 0
+        position = video.currentTime
+      } else if (
+        !video.seeking &&
+        Math.abs(video.currentTime - position) > 0.05
+      )
+        clear()
+      else {
+        blockedAt ||= now
+        if (now - blockedAt >= 15_000) {
+          const shouldPlay = !video.paused
+          clear()
+          recover(shouldPlay)
+        }
+      }
+    }
+    timer = setTimeout(tick, 1000)
+  }
+  document.addEventListener("visibilitychange", visibility)
+  document.addEventListener("freeze", freeze)
+  document.addEventListener("resume", resume)
+  window.addEventListener("pageshow", pageShow)
+  window.addEventListener("focus", focus)
+  window.addEventListener("offline", wentOffline)
+  window.addEventListener("online", online)
+  timer = setTimeout(tick, 1000)
+  return () => {
+    disposed = true
+    clearTimeout(timer)
+    document.removeEventListener("visibilitychange", visibility)
+    document.removeEventListener("freeze", freeze)
+    document.removeEventListener("resume", resume)
+    window.removeEventListener("pageshow", pageShow)
+    window.removeEventListener("focus", focus)
+    window.removeEventListener("offline", wentOffline)
+    window.removeEventListener("online", online)
+  }
+}
