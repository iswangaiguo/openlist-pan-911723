diff --git a/src/utils/directory_snapshot.ts b/src/utils/directory_snapshot.ts
new file mode 100644
index 0000000..5bf1f39
--- /dev/null
+++ b/src/utils/directory_snapshot.ts
@@ -0,0 +1,102 @@
+// Per-tab, memory-only directory snapshots. Never persist private listings.
+// The Worker remains authoritative: every restored snapshot is revalidated.
+export class DirectorySnapshots<T> {
+  private entries = new Map<
+    string,
+    { data: T; expires: number; bytes: number }
+  >()
+  private bytes = 0
+  revision = 0
+  constructor(
+    private now = () => Date.now(),
+    private maxEntries = 32,
+    private maxBytes = 2 * 1024 * 1024,
+  ) {}
+
+  get(key: string): T | undefined {
+    const entry = this.entries.get(key)
+    if (!entry) return
+    if (entry.expires <= this.now()) {
+      this.remove(key)
+      return
+    }
+    this.entries.delete(key)
+    this.entries.set(key, entry)
+    return JSON.parse(JSON.stringify(entry.data))
+  }
+  put(key: string, data: T, revision: number, ttlMs = 120000): void {
+    if (revision !== this.revision || ttlMs <= 0) return
+    const json = JSON.stringify(data)
+    const bytes = new TextEncoder().encode(json).length
+    if (bytes > Math.min(this.maxBytes, 512 * 1024)) return
+    this.remove(key)
+    this.entries.set(key, {
+      data: JSON.parse(json),
+      bytes,
+      expires: this.now() + ttlMs,
+    })
+    this.bytes += bytes
+    while (this.entries.size > this.maxEntries || this.bytes > this.maxBytes) {
+      this.remove(this.entries.keys().next().value!)
+    }
+  }
+  private remove(key: string) {
+    this.bytes -= this.entries.get(key)?.bytes ?? 0
+    this.entries.delete(key)
+  }
+  clear() {
+    this.entries.clear()
+    this.bytes = 0
+    this.revision++
+  }
+}
+
+export const directorySnapshots = new DirectorySnapshots<
+  import("~/types").FsListResp["data"]
+>()
+const invalidationListeners = new Set<() => void>()
+export function onDirectoryInvalidation(listener: () => void) {
+  invalidationListeners.add(listener)
+  return () => {
+    invalidationListeners.delete(listener)
+  }
+}
+export function invalidateDirectories() {
+  directorySnapshots.clear()
+  for (const listener of invalidationListeners) listener()
+}
+
+// Do not restore snapshots whose download signatures are about to expire.
+// Worker and upstream Go use different signature formats; support both.
+export function snapshotTtl(
+  content: Array<{ sign?: string }>,
+  now = Date.now(),
+): number {
+  let ttl = 120000
+  for (const item of content) {
+    if (!item.sign) continue
+    const match =
+      /^(\d+)\.[a-f\d]+$/i.exec(item.sign) || /:(\d+)$/.exec(item.sign)
+    if (!match) return 0
+    const expires = Number(match[1])
+    if (expires > 0) ttl = Math.min(ttl, expires * 1000 - now - 10000)
+  }
+  return Math.max(0, ttl)
+}
+
+export function isDirectoryMutation(method: string, url: string): boolean {
+  if (["get", "head", "options"].includes(method.toLowerCase())) return false
+  const path = url.split("?")[0].replace(/^.*\/api\//, "/")
+  if (path.startsWith("/admin/")) return true
+  if (!path.startsWith("/fs/")) return false
+  return ![
+    "list",
+    "get",
+    "dirs",
+    "search",
+    "link",
+    "archive/list",
+    "archive/meta",
+    "archive/get",
+  ].includes(path.slice(4))
+}
