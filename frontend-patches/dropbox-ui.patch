index 0000000..b3d3a93
--- /dev/null
+++ b/src/pages/home/uploads/recovery.ts
@@ -0,0 +1,208 @@
+import type { UploadTask, UploadTarget } from "./queue"
+import type { MultipartResume } from "./types"
+
+export interface SavedUpload {
+  version: 1
+  token: string
+  name: string
+  path: string
+  directory: string
+  size: number
+  lastModified: number
+  fileName: string
+  method: string
+  asTask: boolean
+  overwrite: boolean
+  rapid: boolean
+  requiresPassword: boolean
+  confirmedBytes: number
+  resume: MultipartResume
+  updatedAt: number
+}
+export interface UploadPersistence {
+  load(): SavedUpload[]
+  get(token: string): SavedUpload | undefined
+  save(record: SavedUpload): void
+  remove(token: string): void
+}
+
+// Store metadata and browser-generated part digests only. File contents,
+// directory passwords and login tokens never enter recovery records.
+export class BrowserUploadPersistence implements UploadPersistence {
+  private prefix: string
+  constructor(
+    private storage: Storage,
+    scope: string,
+  ) {
+    this.prefix = `openlist:uploads:v1:${scope}:`
+  }
+  load() {
+    const records: SavedUpload[] = []
+    for (let i = 0; i < this.storage.length; i++) {
+      const key = this.storage.key(i)
+      if (!key?.startsWith(this.prefix)) continue
+      const record = this.get(key.slice(this.prefix.length))
+      if (record) records.push(record)
+    }
+    return records.sort((a, b) => a.updatedAt - b.updatedAt)
+  }
+  get(token: string) {
+    try {
+      const raw = this.storage.getItem(this.prefix + token)
+      if (!raw || raw.length > 1200000) return
+      const record = JSON.parse(raw)
+      if (
+        record.version !== 1 ||
+        record.token !== token ||
+        !/^[a-zA-Z0-9_-]{16,128}$/.test(token)
+      )
+        return
+      for (const key of ["name", "path", "directory", "fileName"]) {
+        if (
+          typeof record[key] !== "string" ||
+          !record[key] ||
+          record[key].length > 4096 ||
+          record[key].includes("\0")
+        )
+          return
+      }
+      if (!record.path.startsWith("/") || !record.directory.startsWith("/"))
+        return
+      if (
+        !["Multipart", "Stream", "Form", "HTTP Direct"].includes(record.method)
+      )
+        return
+      for (const key of ["asTask", "overwrite", "rapid", "requiresPassword"])
+        if (typeof record[key] !== "boolean") return
+      for (const key of [
+        "size",
+        "lastModified",
+        "confirmedBytes",
+        "updatedAt",
+      ]) {
+        if (!Number.isSafeInteger(record[key]) || record[key] < 0) return
+      }
+      if (
+        record.confirmedBytes > record.size ||
+        !record.resume ||
+        record.resume.token !== token
+      )
+        return
+      const resume = record.resume
+      if (
+        resume.uploadId !== undefined &&
+        (typeof resume.uploadId !== "string" ||
+          !/^mp_[a-zA-Z0-9_-]+$/.test(resume.uploadId))
+      )
+        return
+      if (
+        resume.chunkSize !== undefined &&
+        (!Number.isSafeInteger(resume.chunkSize) ||
+          resume.chunkSize < 1 ||
+          resume.chunkSize > 64 * 1024 * 1024)
+      )
+        return
+      if (
+        !resume.parts ||
+        typeof resume.parts !== "object" ||
+        Array.isArray(resume.parts)
+      )
+        return
+      if (Object.keys(resume.parts).length > 10000) return
+      for (const [index, digest] of Object.entries(resume.parts)) {
+        if (
+          !/^\d+$/.test(index) ||
+          Number(index) >= 10000 ||
+          typeof digest !== "string" ||
+          !/^[a-f0-9]{64}$/.test(digest)
+        )
+          return
+      }
+      if (
+        resume.supported !== undefined &&
+        typeof resume.supported !== "boolean"
+      )
+        return
+      // Copy an explicit allowlist: unrecognized fields cannot become credentials.
+      return {
+        version: 1,
+        token,
+        name: record.name,
+        path: record.path,
+        directory: record.directory,
+        size: record.size,
+        lastModified: record.lastModified,
+        fileName: record.fileName,
+        method: record.method,
+        asTask: record.asTask,
+        overwrite: record.overwrite,
+        rapid: record.rapid,
+        requiresPassword: record.requiresPassword,
+        confirmedBytes: record.confirmedBytes,
+        updatedAt: record.updatedAt,
+        resume: {
+          token,
+          uploadId: resume.uploadId,
+          chunkSize: resume.chunkSize,
+          parts: { ...resume.parts },
+          supported: resume.supported,
+        },
+      } as SavedUpload
+    } catch {
+      return undefined
+    }
+  }
+  save(record: SavedUpload) {
+    const existing = this.get(record.token)
+    // Preserve digests committed by another tab before this tab acquired its lock.
+    if (
+      existing &&
+      (!record.resume.uploadId ||
+        existing.resume.uploadId === record.resume.uploadId)
+    ) {
+      record = {
+        ...record,
+        confirmedBytes: Math.max(
+          record.confirmedBytes,
+          existing.confirmedBytes,
+        ),
+        resume: {
+          ...existing.resume,
+          ...record.resume,
+          uploadId: record.resume.uploadId ?? existing.resume.uploadId,
+          chunkSize: record.resume.chunkSize ?? existing.resume.chunkSize,
+          parts: { ...existing.resume.parts, ...record.resume.parts },
+        },
+      }
+    }
+    this.storage.setItem(this.prefix + record.token, JSON.stringify(record))
+  }
+  remove(token: string) {
+    this.storage.removeItem(this.prefix + token)
+  }
+}
+
+export const savedUpload = (
+  task: UploadTask,
+  target: UploadTarget,
+  lastModified: number,
+  fileName: string,
+  resume: MultipartResume,
+): SavedUpload => ({
+  version: 1,
+  token: resume.token,
+  name: task.name,
+  path: task.path,
+  directory: task.directory,
+  size: task.size,
+  lastModified,
+  fileName,
+  method: target.method,
+  asTask: target.asTask,
+  overwrite: target.overwrite,
+  rapid: target.rapid,
+  requiresPassword: task.requiresPassword,
+  confirmedBytes: task.confirmedBytes,
+  resume: { ...resume, parts: { ...resume.parts } },
+  updatedAt: Date.now(),
+})
