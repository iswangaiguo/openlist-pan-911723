+import { createSignal } from "solid-js"
+
+const [unfinishedUploads, setUnfinishedUploads] = createSignal(0)
+export { unfinishedUploads, setUnfinishedUploads }
+export const isModuleLoadError = (error: unknown) =>
+  /Failed to fetch dynamically imported module|Importing a module script failed|error loading dynamically imported module|Unable to preload CSS|Loading (?:CSS )?chunk [\w-]+ failed/i.test(
+    String(error),
+  )
+
+// Reload at most once per tab within 15 minutes; persistent network/CDN failures
+// need an explicit retry rather than an infinite reload loop. Storage failures
+// also require an explicit retry because we cannot persist the loop guard.
+export function claimModuleReload(
+  storage: Pick<Storage, "getItem" | "setItem">,
+  now: number,
+  blocked = false,
+) {
+  if (blocked) return false
+  try {
