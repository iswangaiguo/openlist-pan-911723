+  background: var(--up-bg);
+  border: 1px solid var(--up-border);
+  border-radius: 6px;
+  font: inherit;
+}
+.upload-task[data-status="paused"] progress::-webkit-progress-value,
+.upload-task[data-status="needs_file"] progress::-webkit-progress-value {
+  background: #929292;
+}
