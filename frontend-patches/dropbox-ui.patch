+  font-size: 11px;
+  padding-top: 4px;
+  overflow-wrap: anywhere;
+}
+.upload-task-status {
+  display: flex;
+  justify-content: space-between;
+  color: var(--up-muted);
+  font-size: 12px;
+  margin: 10px 0 6px;
+}
+.upload-task[data-status="success"] .upload-task-status {
+  color: #168244;
+}
+.upload-task[data-status="error"] .upload-task-status,
+.upload-error {
+  color: #b72c2c;
+}
+.upload-center progress {
+  display: block;
+  width: 100%;
+  height: 4px;
+  border: 0;
