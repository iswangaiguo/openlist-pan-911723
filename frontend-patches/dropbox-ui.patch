+  border-color: #0061ff;
+}
+.upload-center .upload-primary:hover {
+  background: #0052d9;
+}
+.upload-destination {
+  font-size: 12px;
+  color: var(--up-muted);
+  overflow-wrap: anywhere;
+}
+.upload-destination strong {
+  font-weight: 500;
+}
+.upload-options {
+  margin: 0 20px 12px;
+  font-size: 12px;
+}
+.upload-options summary {
+  cursor: pointer;
+  color: var(--up-muted);
