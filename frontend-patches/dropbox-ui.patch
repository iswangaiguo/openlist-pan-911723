diff --git a/src/pages/home/drive.css b/src/pages/home/drive.css
new file mode 100644
index 0000000..1bfa4b9
--- /dev/null
+++ b/src/pages/home/drive.css
@@ -0,0 +1,421 @@
+/* File browser skin, scoped so management and login keep their own layouts. */
+.drive-shell {
+  --drive-bg: #fff;
+  --drive-rail: #f7f5f2;
+  --drive-text: #1e1919;
+  --drive-muted: #706b67;
+  --drive-line: #e8e6e3;
+  --drive-hover: #f7f8fa;
+  --drive-blue: #0061ff;
+  --drive-selected: #eaf1ff;
+  width: 100%;
+  min-height: 100vh;
+  display: grid;
+  grid-template-columns: 228px minmax(0, 1fr);
+  color: var(--drive-text);
+  background: var(--drive-bg);
+  font-size: 14px;
+}
+.drive-shell[data-drive-mode="dark"] {
+  --drive-bg: #181a1e;
+  --drive-rail: #202227;
+  --drive-text: #f1f1f1;
+  --drive-muted: #adafb5;
+  --drive-line: #34373e;
+  --drive-hover: #24272e;
+  --drive-selected: #183354;
+  --drive-blue: #79abff;
+}
+.drive-shell button {
+  font: inherit;
+  cursor: pointer;
+}
+.drive-shell button:focus-visible {
+  outline: 3px solid #6da3ff;
+  outline-offset: 3px;
+}
+.drive-rail {
+  position: sticky;
+  top: 0;
+  height: 100vh;
+  padding: 32px 18px 20px;
+  display: flex;
+  flex-direction: column;
+  background: var(--drive-rail);
+  border-right: 1px solid var(--drive-line);
+}
+.drive-brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+  font-size: 18px;
+  font-weight: 700;
+  letter-spacing: -0.5px;
+}
+.drive-brand > span:last-child {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.drive-brand-mark {
+  width: 32px;
+  height: 32px;
+  display: grid;
+  place-items: center;
+  background: #0061ff;
+  color: white;
+  border-radius: 5px;
+  flex-shrink: 0;
+}
+.drive-rail .drive-brand {
+  padding: 0 10px;
+}
+.drive-rail-label {
+  margin: 48px 12px 12px;
+  color: var(--drive-muted);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 1px;
+  text-transform: uppercase;
+}
+.drive-rail-nav {
+  display: grid;
+  gap: 5px;
+}
+.drive-nav-item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  text-align: left;
+  width: 100%;
+  border: 0;
+  border-radius: 5px;
+  padding: 13px 12px;
+  color: var(--drive-text);
+  background: transparent;
+}
+.drive-nav-item svg {
+  width: 19px;
+  height: 19px;
+}
+.drive-nav-item:hover {
+  background: var(--drive-line);
+}
+.drive-nav-current {
+  background: var(--drive-selected);
+  color: var(--drive-blue);
+  font-weight: 600;
+}
+.drive-account {
+  margin-top: auto;
+  padding: 16px 8px 0;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  text-align: left;
+  border: 0;
+  border-top: 1px solid var(--drive-line);
+  background: transparent;
+  color: var(--drive-text);
+  min-width: 0;
+}
+.drive-account > span:last-child {
+  min-width: 0;
+}
+.drive-account strong {
+  display: block;
+  font-size: 13px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.drive-account small {
+  display: block;
+  margin-top: 3px;
+  color: var(--drive-muted);
+  font-size: 11px;
+}
+.drive-avatar {
+  width: 34px;
+  height: 34px;
+  flex-shrink: 0;
+  display: grid;
+  place-items: center;
+  background: #e4ded7;
+  color: #524a43;
+  border-radius: 50%;
+  font-weight: 600;
+}
+.drive-main {
+  min-width: 0;
+}
+.drive-shell .drive-container {
+  width: 100%;
+  max-width: 1440px;
+  margin-inline: auto;
+  padding-inline: 40px;
+}
+.drive-header {
+  background: var(--drive-bg);
+  border-bottom: 1px solid var(--drive-line);
+}
+.drive-header-inner {
+  height: 88px;
+  display: flex;
+  align-items: center;
+  gap: 20px;
+}
+.drive-search {
+  width: min(480px, 100%);
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  border: 1px solid var(--drive-line);
+  border-radius: 5px;
+  background: var(--drive-hover);
+  color: var(--drive-muted);
+  padding: 11px 14px;
+  text-align: left;
+}
+.drive-search:hover {
+  border-color: #b7c8e6;
+}
+.drive-search-shortcut {
+  margin-left: auto;
+  font-size: 11px;
+}
+.drive-header-tools {
+  margin-left: auto;
+  display: flex;
+  gap: 8px;
+  align-items: center;
+}
+.drive-header-tools > button {
+  border-radius: 5px;
+}
+.drive-mobile-brand,
+.drive-mobile-settings {
+  display: none !important;
+}
+.drive-shell .body {
+  padding: 30px 0 0;
+  min-height: calc(100vh - 160px);
+  gap: 20px;
+}
+.drive-shell .nav {
+  background: var(--drive-bg);
+  font-size: 12px;
+  color: var(--drive-muted);
+}
+.drive-shell .nav::after {
+  display: none;
+}
+.drive-shell .nav-link {
+  padding: 3px 0;
+  border-radius: 3px;
+}
+.drive-heading {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  margin: 2px 0 10px;
+}
+.drive-heading h1 {
+  font-size: 30px;
+  font-weight: 600;
+  line-height: 1.25;
+  letter-spacing: -0.8px;
+  overflow-wrap: anywhere;
+  margin: 0;
+}
+.drive-actions {
+  display: flex;
+  gap: 10px;
+  align-items: center;
+  flex-shrink: 0;
+}
+.drive-button,
+.drive-icon-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 9px;
+  border: 1px solid var(--drive-line);
+  border-radius: 5px;
+  color: var(--drive-text);
+  background: var(--drive-bg);
+  min-height: 40px;
+  padding: 0 14px;
+  font-weight: 500 !important;
+}
+.drive-icon-button {
+  padding: 0;
+  width: 40px;
+  font-size: 18px !important;
+}
+.drive-button svg {
+  width: 17px;
+  height: 17px;
+}
+.drive-button:hover,
+.drive-icon-button:hover {
+  background: var(--drive-hover);
+  border-color: #b6b8be;
+}
+.drive-button-primary {
+  background: #0061ff;
+  color: white;
+  border-color: #0061ff;
+}
+.drive-button-primary:hover {
+  background: #0052d9;
+  border-color: #0052d9;
+}
+.drive-shell .obj-box {
+  padding: 0;
+  background: var(--drive-bg);
+  border-radius: 0;
+  box-shadow: none;
+}
+.drive-shell .list {
+  gap: 0;
+}
+.drive-shell .list .title {
+  padding: 12px 16px;
+  font-size: 12px;
+  color: var(--drive-muted);
+  border-bottom: 1px solid var(--drive-line);
+}
+.drive-shell .list-item {
+  padding: 18px 16px;
+  min-height: 64px;
+  border-radius: 0;
+  border-bottom: 1px solid var(--drive-line);
+  transition: background 0.15s;
+}
+.drive-shell .list-item:hover {
+  transform: none;
+  background: var(--drive-hover);
+}
+.drive-shell .list-item.selected {
+  background: var(--drive-selected);
+}
+.drive-shell .list-item .icon {
+  width: 28px;
+  height: 28px;
+  margin-right: 10px;
+  flex-shrink: 0;
+  color: var(--drive-blue);
+}
+.drive-shell .list-item .name {
+  font-weight: 500;
+}
+.drive-shell .list-item .size,
+.drive-shell .list-item .modified {
+  color: var(--drive-muted);
+  font-size: 13px;
+  font-variant-numeric: tabular-nums;
+}
+.drive-shell .footer {
+  color: var(--drive-muted);
+  font-size: 11px;
+  padding: 22px 0;
+}
+.drive-upload {
+  gap: 16px;
+}
+.drive-upload-file {
+  padding: 16px;
+  border-radius: 6px;
+  gap: 10px;
+}
+.drive-upload-file > p:first-child {
+  font-weight: 600;
+}
+.drive-upload-percent {
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+@media (max-width: 1100px) {
+  .drive-shell {
+    grid-template-columns: 196px minmax(0, 1fr);
+  }
+  .drive-shell .drive-container {
+    padding-inline: 24px;
+  }
+}
+@media (max-width: 760px) {
+  .drive-shell {
+    display: block;
+  }
+  .drive-rail {
+    display: none;
+  }
+  .drive-shell .drive-container {
+    padding-inline: 18px;
+  }
+  .drive-mobile-brand,
+  .drive-mobile-settings {
+    display: flex !important;
+  }
+  .drive-mobile-brand {
+    max-width: 50%;
+  }
+  .drive-brand {
+    font-size: 16px;
+  }
+  .drive-header-inner {
+    height: auto;
+    min-height: 72px;
+    flex-wrap: wrap;
+    gap: 12px;
+    padding-block: 16px;
+  }
+  .drive-search {
+    order: 3;
+    width: 100%;
+  }
+  .drive-search-shortcut {
+    display: none;
+  }
+  .drive-shell .body {
+    padding-top: 22px;
+    gap: 16px;
+  }
+  .drive-heading {
+    flex-wrap: wrap;
+    margin-bottom: 8px;
+  }
+  .drive-heading h1 {
+    font-size: 26px;
+  }
+  .drive-actions {
+    gap: 8px;
+  }
+  .drive-button {
+    padding-inline: 12px;
+  }
+  .drive-shell .list-item {
+    padding: 16px 8px;
+    min-height: 64px;
+  }
+  .drive-shell .list .title {
+    padding-inline: 8px;
+  }
+  .drive-shell .list-item .icon {
+    width: 24px;
+    height: 24px;
+    margin-right: 6px;
+  }
+  .drive-upload-file {
+    padding: 12px;
+    font-size: 13px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .drive-shell .list-item {
+    transition: none;
+  }
+}
