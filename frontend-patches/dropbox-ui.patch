@@ -0,0 +1,105 @@
+import { Icon, Menu, MenuContent, MenuItem, MenuTrigger } from "@hope-ui/solid"
+import { For, Show } from "solid-js"
+import { BsCheck2Square, BsDownload, BsThreeDots } from "solid-icons/bs"
+import { useCopyLink, useDownload, useRouter, useT } from "~/hooks"
+import {
+  checkboxOpen,
+  haveSelected,
+  objStore,
+  selectedMsg,
+  selectAll,
+  State,
+  toggleCheckbox,
+  layout,
+  userCan,
+} from "~/store"
+import { currentLang } from "~/app/i18n"
+import { bus } from "~/utils"
+
+// Keep file operations alongside the list, and use the existing handlers.
+export const DriveSelection = () => {
+  const t = useT()
+  const { isShare } = useRouter()
+  const { batchDownloadSelected } = useDownload()
+  const { copySelectedPreviewPage } = useCopyLink()
+  const isFolder = () =>
+    [State.Folder, State.FetchingMore].includes(objStore.state)
+  const canEdit = (name: "rename" | "move" | "copy" | "delete") =>
+    !isShare() && objStore.write && userCan(name)
+  const closeSelection = () => {
+    selectAll(false)
+    if (layout() !== "list" && checkboxOpen()) toggleCheckbox()
+  }
+  const selectLabel = () =>
+    String(currentLang()).startsWith("zh") ? "选择文件" : "Select files"
+  const hint = () =>
+    String(currentLang()).startsWith("zh")
+      ? "勾选文件后可下载或管理"
+      : "Select files to download or manage"
+  return (
+    <Show when={isFolder()}>
+      <div class="drive-file-tools" role="group" aria-label={selectLabel()}>
+        <Show when={haveSelected() || layout() !== "list"}>
+          <Show
+            when={haveSelected() || checkboxOpen()}
+            fallback={
+              <button class="drive-select-button" onClick={toggleCheckbox}>
+                <Icon as={BsCheck2Square} />
+                <span>{selectLabel()}</span>
+              </button>
+            }
+          >
+            <span class="drive-selection-count" role="status">
+              {haveSelected() ? selectedMsg() : hint()}
+            </span>
+            <div class="drive-selection-actions">
+              <Show when={haveSelected()}>
+                <button class="drive-button" onClick={batchDownloadSelected}>
+                  <Icon as={BsDownload} />
+                  <span>{t("home.toolbar.download")}</span>
+                </button>
+                <Menu placement="bottom-end">
+                  <MenuTrigger
+                    as="button"
+                    class="drive-button"
+                    aria-label={t("home.toolbar.more")}
+                  >
+                    <Icon as={BsThreeDots} />
+                    <span>{t("home.toolbar.more")}</span>
+                  </MenuTrigger>
+                  <MenuContent>
+                    <For each={["rename", "move", "copy", "delete"] as const}>
+                      {(name) => (
+                        <Show when={canEdit(name)}>
+                          <MenuItem
+                            colorScheme={
+                              name === "delete" ? "danger" : "neutral"
+                            }
+                            onSelect={() => bus.emit("tool", name)}
+                          >
+                            {t(`home.toolbar.${name}`)}
+                          </MenuItem>
+                        </Show>
+                      )}
+                    </For>
+                    <Show when={!isShare() && userCan("share")}>
+                      <MenuItem onSelect={() => bus.emit("tool", "share")}>
+                        {t("home.toolbar.share")}
+                      </MenuItem>
+                    </Show>
+                    <MenuItem onSelect={copySelectedPreviewPage}>
+                      {t("home.toolbar.copy_link")}
+                    </MenuItem>
+                  </MenuContent>
+                </Menu>
+              </Show>
+              <button class="drive-select-button" onClick={closeSelection}>
+                {t("home.toolbar.cancel_select")}
+              </button>
+            </div>
+          </Show>
+        </Show>
+      </div>
+    </Show>
+  )
+}
diff --git a/src/pages/home/DriveUsage.tsx b/src/pages/home/DriveUsage.tsx
new file mode 100644
index 0000000..6387c6b
--- /dev/null
+++ b/src/pages/home/DriveUsage.tsx
@@ -0,0 +1,160 @@
+import { createEffect, createSignal, on, onCleanup, Show } from "solid-js"
+import { currentLang } from "~/app/i18n"
+import { useRouter } from "~/hooks"
+import { me } from "~/store"
+import { UserMethods } from "~/types"
+import { r } from "~/utils"
+
+type Usage = { mount: string; bytes: number; at: number }
+const cache = new Map<string, Usage>()
+
+export const DriveUsage = () => {
+  const { isShare } = useRouter()
+  const media = window.matchMedia("(min-width: 761px)")
+  const [desktop, setDesktop] = createSignal(media.matches)
+  const resized = () => setDesktop(media.matches)
+  media.addEventListener("change", resized)
+  const [usage, setUsage] = createSignal<Usage>()
+  const [status, setStatus] = createSignal("loading")
+  const [unavailable, setUnavailable] = createSignal(0)
+  let generation = 0
+  let controller: AbortController | undefined
+  let timer: ReturnType<typeof setTimeout> | undefined
+  const zh = () => String(currentLang()).startsWith("zh")
+  const load = async () => {
+    const version = ++generation
+    controller?.abort()
+    setUsage(undefined)
+    setUnavailable(0)
+    if (!desktop() || !UserMethods.is_admin(me()) || isShare()) return
+    const key = String(me().id)
+    controller = new AbortController()
+    const signal = controller.signal
+    setStatus("loading")
+    let total = 0
+    let counted = 0
+    let missing = 0
+    try {
+      const inventory = (await r.get("/fs/usage", {
+        params: { scope: "all" },
+        signal,
+      })) as any
+      if (version !== generation) return
+      if (inventory.code !== 200 || !Array.isArray(inventory.data?.mounts))
+        throw new Error("Usage unavailable")
+      // Fetch bounded metadata pages separately to stay within Worker limits.
+      for (const mount of inventory.data.mounts) {
+        const cacheKey = key + ":" + mount.storage_id + ":" + mount.mount_path
+        const saved = cache.get(cacheKey)
+        if (saved && Date.now() - saved.at < 300000) {
+          total += saved.bytes
+          counted++
+          continue
+        }
+        let bytes = 0
+        let cursor: string | undefined
+        let supported = true
+        try {
+          do {
+            const response = (await r.get("/fs/usage", {
+              params: { path: mount.mount_path, cursor },
+              signal,
+            })) as any
+            if (version !== generation) return
+            if (response.code !== 200) throw new Error("Usage unavailable")
+            const data = response.data
+            if (!data?.supported || data.storage_id !== mount.storage_id) {
+              supported = false
+              break
+            }
+            if (!Number.isFinite(data.bytes) || data.bytes < 0)
+              throw new Error("Invalid usage")
+            bytes += data.bytes
+            cursor = data.cursor
+          } while (cursor)
+        } catch {
+          if (version !== generation) return
+          supported = false
+        }
+        if (!supported) {
+          missing++
+          continue
+        }
+        cache.set(cacheKey, { mount: mount.mount_path, bytes, at: Date.now() })
+        total += bytes
+        counted++
+      }
+      if (version !== generation) return
+      setUnavailable(missing)
+      if (missing && !counted) {
+        setStatus("error")
+        return
+      }
+      setUsage({ mount: "", bytes: total, at: Date.now() })
+      setStatus("ready")
+    } catch {
+      if (version === generation) setStatus("error")
+    }
+  }
+  createEffect(on([desktop, () => me().id, () => me().role, isShare], load))
+  const identityChanged = () => {
+    cache.clear()
+    void load()
+  }
+  window.addEventListener("openlist:identity-change", identityChanged)
+  const completed = () => {
+    cache.clear()
+    clearTimeout(timer)
+    timer = setTimeout(load, 500)
+  }
+  window.addEventListener("openlist:upload-complete", completed)
+  onCleanup(() => {
+    generation++
+    media.removeEventListener("change", resized)
+    controller?.abort()
+    clearTimeout(timer)
+    window.removeEventListener("openlist:upload-complete", completed)
+    window.removeEventListener("openlist:identity-change", identityChanged)
+  })
+  const label = () =>
+    ({
+      loading: zh() ? "正在统计用量…" : "Calculating usage…",
+      unsupported: zh()
+        ? "此存储不提供用量"
+        : "Usage unavailable for this storage",
+      error: zh() ? "暂时无法获取用量" : "Unable to load usage",
+    })[status()]
+  return (
+    <Show when={UserMethods.is_admin(me()) && !isShare()}>
+      <div class="drive-usage" aria-live="polite">
+        <span>{zh() ? "总存储用量" : "Total storage usage"}</span>
+        <Show when={usage()} fallback={<p>{label()}</p>}>
+          <strong>
+            {unavailable()
+              ? zh()
+                ? "已统计"
+                : "Counted"
+              : zh()
+                ? "已使用"
+                : "Used"}{" "}
+            {(usage()!.bytes / 1e9).toLocaleString(
+              String(currentLang()).startsWith("zh") ? "zh-CN" : "en-US",
+              { maximumFractionDigits: 2 },
+            )}{" "}
+            GB
+          </strong>
+          <Show when={unavailable()}>
+            <small>
+              {zh()
+                ? `${unavailable()} 个存储暂无法统计`
+                : `Usage unavailable for ${unavailable()} storage(s)`}
+            </small>
+          </Show>
+        </Show>
+        <Show when={status() === "error"}>
+          <button onClick={load}>{zh() ? "重试" : "Retry"}</button>
+        </Show>
+      </div>
+    </Show>
+  )
+}
