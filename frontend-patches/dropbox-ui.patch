+.upload-center {
+  --up-bg: #fff;
+  --up-text: #1e1919;
+  --up-muted: #706d69;
+  --up-border: #e8e5e1;
+  --up-soft: #f7f5f2;
+  position: fixed;
+  z-index: 1200;
+  right: 24px;
+  bottom: 24px;
+  width: 420px;
+  max-width: calc(100vw - 24px);
+  color: var(--up-text);
+  background: var(--up-bg);
+  border: 1px solid var(--up-border);
+  border-radius: 14px;
+  box-shadow: 0 12px 48px #1e191929;
+  font-size: 14px;
+  overflow: hidden;
+}
+.upload-center[data-mode="dark"] {
+  --up-bg: #242424;
+  --up-text: #f3f1ed;
+  --up-muted: #aaa8a3;
+  --up-border: #414141;
+  --up-soft: #303030;
+}
+.upload-center button,
+.upload-center select {
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+  background: var(--up-bg);
+  border: 1px solid var(--up-border);
+  border-radius: 6px;
+  padding: 9px 12px;
+}
+.upload-center button:hover {
+  background: var(--up-soft);
+}
+.upload-center button:focus-visible,
+.upload-center select:focus-visible,
+.upload-center summary:focus-visible {
+  outline: 2px solid #0061ff;
+  outline-offset: 2px;
+}
+.upload-center button:disabled {
+  opacity: 0.45;
+  cursor: default;
+}
+.upload-center-header {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 18px 20px;
+  border-bottom: 1px solid var(--up-border);
+}
+.upload-center h2 {
+  font-size: 17px;
+  font-weight: 650;
+  margin: 0;
+}
+.upload-center p {
+  margin: 0;
+}
+.upload-center-header p {
+  font-size: 12px;
+  color: var(--up-muted);
+  margin-top: 3px;
+}
+.upload-mark {
+  display: grid;
+  place-items: center;
+  width: 32px;
+  height: 32px;
+  border-radius: 8px;
+  background: #eaf2ff;
+  color: #0061ff;
+  font-size: 23px;
+  flex-shrink: 0;
+}
+.upload-center .upload-icon-button {
+  margin-left: auto;
+  border: 0;
+  font-size: 24px;
+  line-height: 1;
+  padding: 8px;
+}
+.upload-center-body {
+  max-height: min(62dvh, 560px);
+  overflow: auto;
+  overscroll-behavior: contain;
+}
+.upload-picker {
+  margin: 16px 20px 10px;
+  padding: 18px 12px;
+  text-align: center;
+  background: var(--up-soft);
+  border: 1px dashed var(--up-border);
+  border-radius: 8px;
+}
+.upload-picker[data-dragging="true"] {
+  border-color: #0061ff;
+  background: #eaf2ff;
+  color: #1e1919;
+}
+.upload-picker-actions {
+  display: flex;
+  justify-content: center;
+  gap: 8px;
+  margin: 14px 0;
+}
+.upload-center .upload-primary {
+  background: #0061ff;
