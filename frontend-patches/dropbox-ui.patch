new file mode 100644
index 0000000..bf13d9b
--- /dev/null
+++ b/src/pages/home/folder/open-item.ts
@@ -0,0 +1,15 @@
+import type { StoreObj } from "~/types"
+import { joinBase } from "~/utils"
+
+// Keep folder navigation in the current tab. A file preview gets its own tab.
+export function openItem(
+  obj: Pick<StoreObj, "is_dir">,
+  href: string,
+  navigate: (path: string) => void,
+) {
+  if (obj.is_dir) {
+    navigate(href)
+  } else {
+    window.open(joinBase(href), "_blank", "noopener,noreferrer")
+  }
+}
