+import type {
+  Upload,
+  UploadCheckpoint,
+  UploadFileProps,
+  MultipartResume,
+} from "./types"
+import type { UploadPersistence } from "./recovery"
+import { savedUpload } from "./recovery"
+
+export interface UploadTarget {
+  directory: string
+  password: string
+  uploader: Upload
+  method: string
+  asTask: boolean
+  overwrite: boolean
+  rapid: boolean
+}
+export interface UploadTask extends UploadFileProps {
+  id: number
+  directory: string
+  method: string
+  confirmedBytes: number
+  requiresPassword: boolean
+  resumable: boolean
+}
+interface Job {
+  task: UploadTask
+  file?: File
+  lastModified: number
+  fileName: string
+  target: UploadTarget
+  resume: MultipartResume
+  persistence?: UploadPersistence
+  controller?: AbortController
+  running: boolean
+}
+interface QueueOptions {
+  warning?: () => void
+  exclusive?: (
+    token: string,
+    run: () => Promise<Error | undefined>,
+  ) => Promise<Error | undefined>
+  discard?: (uploadId: string) => Promise<unknown>
+  probe?: (
+    uploadId: string,
+    signal: AbortSignal,
+  ) => Promise<"completed" | undefined>
+}
+
+// The queue owns transports and recovery records independently of the panel.
+export class UploadQueue {
+  private jobs: Job[] = []
+  private serial = 0
+  private running = 0
+  private online = true
+  private persistence?: UploadPersistence
+  constructor(
+    private changed: (tasks: UploadTask[]) => void,
+    private completed: (directory: string) => void,
+    private concurrency = 3,
+    private options: QueueOptions = {},
+  ) {}
+  private emit() {
+    this.changed(this.jobs.map(({ task }) => ({ ...task })))
+  }
+  private save(job: Job) {
+    try {
+      if (["success", "cancelled"].includes(job.task.status))
+        job.persistence?.remove(job.resume.token)
+      else
+        job.persistence?.save(
+          savedUpload(
+            job.task,
+            job.target,
+            job.lastModified,
+            job.fileName,
+            job.resume,
+          ),
+        )
+    } catch {
+      this.options.warning?.()
+    }
+  }
+  restore(
+    persistence: UploadPersistence,
+    uploader: (name: string) => Upload | undefined,
+  ) {
+    this.persistence = persistence
+    try {
+      for (const record of persistence.load()) {
+        const upload = uploader(record.method)
+        if (
+          !upload ||
+          this.jobs.some((job) => job.resume.token === record.token)
+        )
+          continue
+        this.jobs.push({
+          running: false,
+          persistence,
+          lastModified: record.lastModified,
+          fileName: record.fileName,
+          target: {
+            directory: record.directory,
+            password: "",
+            uploader: upload,
+            method: record.method,
+            asTask: record.asTask,
+            overwrite: record.overwrite,
+            rapid: record.rapid,
+          },
+          resume: record.resume,
+          task: {
+            id: ++this.serial,
+            name: record.name,
+            path: record.path,
+            directory: record.directory,
+            size: record.size,
+            method: record.method,
+            speed: 0,
+            status: "needs_file",
+            progress: record.size
+              ? (record.confirmedBytes / record.size) * 100
+              : 0,
+            confirmedBytes: record.confirmedBytes,
+            requiresPassword: record.requiresPassword,
+            resumable:
+              record.method === "Multipart" &&
+              record.resume.supported !== false,
+          },
+        })
+      }
+    } catch {
+      this.options.warning?.()
+    }
+    this.emit()
+    for (const job of this.jobs)
+      if (job.task.status === "needs_file" && job.resume.uploadId)
+        void this.probe(job)
+  }
+  private async probe(job: Job) {
+    if (!this.options.probe || !job.resume.uploadId) return
