new file mode 100644
index 0000000..f63c6ef
--- /dev/null
+++ b/src/pages/home/DriveChrome.tsx
@@ -0,0 +1,133 @@
+import { Icon, Image, useColorModeValue } from "@hope-ui/solid"
+import { Show } from "solid-js"
+import {
+  BsFolder2,
+  BsArrowUpCircle,
+  BsGear,
+  BsPlusLg,
+  BsArrowClockwise,
+} from "solid-icons/bs"
+import { useRouter, usePath, useT } from "~/hooks"
+import { currentLang } from "~/app/i18n"
+import { getSetting, me, objStore, State, userCan } from "~/store"
+import { UserMethods } from "~/types"
+import { bus } from "~/utils"
+
+export const driveText = (key: "files" | "workspace" | "waiting") => {
+  const zh = String(currentLang()).startsWith("zh")
+  return {
+    files: zh ? "所有文件" : "All files",
+    workspace: zh ? "文件空间" : "Workspace",
+    waiting: zh ? "等待传输" : "Waiting for transfer",
+  }[key]
+}
+
+export const DriveBrand = () => {
+  const logos = getSetting("logo").split("\n")
+  const logo = useColorModeValue(logos[0], logos[1] || logos[0])
+  return (
+    <div class="drive-brand">
+      <Show when={logo()} fallback={<span class="drive-brand-mark">O</span>}>
+        <Image
+          src={logo()}
+          alt=""
+          width="32px"
+          height="32px"
+          objectFit="contain"
+        />
+      </Show>
+      <span>{getSetting("site_title") || "OpenList"}</span>
+    </div>
+  )
+}
+
+export const DriveRail = () => {
+  const t = useT()
+  const { to, isShare } = useRouter()
+  return (
+    <aside class="drive-rail" aria-label={driveText("workspace")}>
+      <DriveBrand />
+      <div class="drive-rail-label">{driveText("workspace")}</div>
+      <nav class="drive-rail-nav">
+        <Show when={!isShare()}>
+          <button
+            class="drive-nav-item drive-nav-current"
+            onClick={() => to("/")}
+          >
+            <Icon as={BsFolder2} />
+            <span>{driveText("files")}</span>
+          </button>
+        </Show>
+        <button
+          class="drive-nav-item"
+          onClick={() => bus.emit("tool", "local_settings")}
+        >
+          <Icon as={BsGear} />
+          <span>{t("home.toolbar.local_settings")}</span>
+        </button>
+      </nav>
+      <button
+        class="drive-account"
+        onClick={() => to(UserMethods.is_guest(me()) ? "/@login" : "/@manage")}
+      >
+        <span class="drive-avatar">
+          {(me().username || "O").slice(0, 1).toUpperCase()}
+        </span>
+        <span>
+          <strong>{me().username || "OpenList"}</strong>
+          <small>
+            {t(
+              UserMethods.is_guest(me()) ? "login.login" : "home.footer.manage",
+            )}
+          </small>
+        </span>
+      </button>
+    </aside>
+  )
+}
+
+export const DriveHeading = () => {
+  const t = useT()
+  const { pathname, isShare } = useRouter()
+  const { refresh } = usePath()
+  const canWrite = () =>
+    objStore.state === State.Folder &&
+    !isShare() &&
+    (userCan("write_content") || objStore.write_content_bypass) &&
+    objStore.write
+  return (
+    <div class="drive-heading">
+      <h1>
+        {pathname() === "/"
+          ? driveText("files")
+          : pathname().split("/").filter(Boolean).pop()}
+      </h1>
+      <div class="drive-actions">
+        <button
+          class="drive-icon-button"
+          aria-label={t("home.toolbar.refresh")}
+          title={t("home.toolbar.refresh")}
+          onClick={() => refresh(undefined, true)}
+        >
+          <Icon as={BsArrowClockwise} />
+        </button>
+        <Show when={canWrite()}>
+          <button
+            class="drive-button"
+            onClick={() => bus.emit("tool", "mkdir")}
+          >
+            <Icon as={BsPlusLg} />
+            <span>{t("home.toolbar.mkdir")}</span>
+          </button>
+          <button
+            class="drive-button drive-button-primary"
+            onClick={() => bus.emit("tool", "upload")}
+          >
+            <Icon as={BsArrowUpCircle} />
+            <span>{t("home.toolbar.upload")}</span>
+          </button>
+        </Show>
+      </div>
+    </div>
+  )
+}
diff --git a/src/pages/home/DriveSelection.tsx b/src/pages/home/DriveSelection.tsx
new file mode 100644
index 0000000..462c67c
--- /dev/null
+++ b/src/pages/home/DriveSelection.tsx
@@ -0,0 +1,100 @@
+import { Icon, Menu, MenuContent, MenuItem, MenuTrigger } from "@hope-ui/solid"
+import { For, Show } from "solid-js"
+import { BsCheck2Square, BsDownload, BsThreeDots } from "solid-icons/bs"
+import { useCopyLink, useDownload, useRouter, useT } from "~/hooks"
+import {
+  checkboxOpen,
+  haveSelected,
+  objStore,
+  selectedMsg,
+  selectAll,
+  State,
+  toggleCheckbox,
+  userCan,
+} from "~/store"
+import { currentLang } from "~/app/i18n"
+import { bus } from "~/utils"
+
+// Keep file operations alongside the list, and use the existing handlers.
+export const DriveSelection = () => {
+  const t = useT()
+  const { isShare } = useRouter()
+  const { batchDownloadSelected } = useDownload()
+  const { copySelectedPreviewPage } = useCopyLink()
+  const isFolder = () =>
+    [State.Folder, State.FetchingMore].includes(objStore.state)
+  const canEdit = (name: "rename" | "move" | "copy" | "delete") =>
+    !isShare() && objStore.write && userCan(name)
+  const closeSelection = () => {
+    selectAll(false)
+    if (checkboxOpen()) toggleCheckbox()
+  }
+  const selectLabel = () =>
+    String(currentLang()).startsWith("zh") ? "选择文件" : "Select files"
+  const hint = () =>
+    String(currentLang()).startsWith("zh")
+      ? "勾选文件后可下载或管理"
+      : "Select files to download or manage"
+  return (
+    <Show when={isFolder()}>
+      <div class="drive-file-tools" role="group" aria-label={selectLabel()}>
+        <Show
+          when={checkboxOpen()}
+          fallback={
+            <button class="drive-select-button" onClick={toggleCheckbox}>
+              <Icon as={BsCheck2Square} />
+              <span>{selectLabel()}</span>
+            </button>
+          }
+        >
+          <span class="drive-selection-count" role="status">
+            {haveSelected() ? selectedMsg() : hint()}
+          </span>
+          <div class="drive-selection-actions">
+            <Show when={haveSelected()}>
+              <button class="drive-button" onClick={batchDownloadSelected}>
+                <Icon as={BsDownload} />
+                <span>{t("home.toolbar.download")}</span>
+              </button>
+              <Menu placement="bottom-end">
+                <MenuTrigger
+                  as="button"
+                  class="drive-button"
+                  aria-label={t("home.toolbar.more")}
+                >
+                  <Icon as={BsThreeDots} />
+                  <span>{t("home.toolbar.more")}</span>
+                </MenuTrigger>
+                <MenuContent>
+                  <For each={["rename", "move", "copy", "delete"] as const}>
+                    {(name) => (
+                      <Show when={canEdit(name)}>
+                        <MenuItem
+                          colorScheme={name === "delete" ? "danger" : "neutral"}
+                          onSelect={() => bus.emit("tool", name)}
+                        >
+                          {t(`home.toolbar.${name}`)}
+                        </MenuItem>
+                      </Show>
+                    )}
+                  </For>
+                  <Show when={!isShare() && userCan("share")}>
+                    <MenuItem onSelect={() => bus.emit("tool", "share")}>
+                      {t("home.toolbar.share")}
+                    </MenuItem>
+                  </Show>
+                  <MenuItem onSelect={copySelectedPreviewPage}>
+                    {t("home.toolbar.copy_link")}
+                  </MenuItem>
+                </MenuContent>
+              </Menu>
+            </Show>
+            <button class="drive-select-button" onClick={closeSelection}>
+              {t("home.toolbar.cancel_select")}
+            </button>
+          </div>
+        </Show>
+      </div>
+    </Show>
+  )
+}
