+  overflow: hidden;
+  accent-color: #0061ff;
+  background: var(--up-soft);
+}
+.upload-center progress::-webkit-progress-bar {
+  background: var(--up-soft);
+}
+.upload-center progress::-webkit-progress-value {
+  background: #0061ff;
+  border-radius: 4px;
+}
+.upload-center progress::-moz-progress-bar {
+  background: #0061ff;
+}
+.upload-error {
+  font-size: 12px;
+  overflow-wrap: anywhere;
+  padding-top: 8px;
+}
+.upload-center .upload-row-action {
+  padding: 4px 0;
+  margin-top: 8px;
+  border: 0;
+  background: transparent;
+  color: #0061ff;
+  font-size: 12px;
+}
+.upload-center-footer {
+  padding: 12px 20px;
+  border-top: 1px solid var(--up-border);
+  color: var(--up-muted);
+  font-size: 11px;
+}
+.upload-dock {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: 100%;
+  text-align: left;
+}
+.upload-center .upload-dock {
+  border: 0;
+  border-radius: 0;
+  padding: 12px 16px;
+}
+.upload-dock strong {
+  margin-left: auto;
+  font-size: 12px;
+}
+.upload-dock span:nth-child(2) {
+  font-weight: 550;
+}
+@media (max-width: 600px) {
+  .upload-center {
+    right: 12px;
