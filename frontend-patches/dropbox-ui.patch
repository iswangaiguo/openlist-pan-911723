+import { currentLang } from "~/app/i18n"
+import { createSignal, onMount, Show } from "solid-js"
+import { usePath, useRouter, useT } from "~/hooks"
+import { me, objStore, userCan } from "~/store"
+import { inlineRename, setInlineRename } from "~/store/inline_rename"
+import { notify, pathJoin, validateFilename, r } from "~/utils"
+import { StoreObj } from "~/types"
+
+const activeRenames = new Set<string>()
+
+export const InlineRename = (props: { obj: StoreObj }) => {
+  const session = inlineRename()!
+  const { pathname, isShare } = useRouter()
+  const { refresh } = usePath()
+  const t = useT()
+  const [name, setName] = createSignal(session.name)
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal("")
+  const key = `openlist:rename:${session.owner}:${session.directory}:${session.name}`
+  const [progress, setProgress] = createSignal("")
+  let ticket: string | undefined
+  let processed = 0
+  try {
+    const saved = JSON.parse(sessionStorage.getItem(key) || "null")
+    if (saved?.ticket && saved?.name) {
+      ticket = saved.ticket
+      processed = Number(saved.processed) || 0
+      setName(saved.name)
+    }
+  } catch {}
+  const remember = () => {
+    try {
+      sessionStorage.setItem(
+        key,
+        JSON.stringify({ ticket, name: name(), processed }),
+      )
+    } catch {}
+  }
+  const forget = () => {
+    try {
+      sessionStorage.removeItem(key)
+    } catch {}
+  }
+  const text = (zh: string, en: string) =>
+    String(currentLang()).startsWith("zh") ? zh : en
+  let input!: HTMLInputElement
+  onMount(() =>
+    queueMicrotask(() => {
+      if (!input.isConnected) return
+      input.focus()
+      const dot = session.name.lastIndexOf(".")
+      input.setSelectionRange(
+        0,
+        !props.obj.is_dir && dot > 0 ? dot : session.name.length,
+      )
+    }),
+  )
+  const close = () => {
+    if (inlineRename() === session) setInlineRename(undefined)
+  }
+  const submit = async () => {
+    if (busy() || inlineRename() !== session) return
+    if (
+      pathname() !== session.directory ||
+      me().id !== session.owner ||
+      isShare() ||
+      !objStore.write ||
+      !userCan("rename")
+    ) {
+      close()
+      return
+    }
+    const validation = validateFilename(name())
+    if (!validation.valid) {
+      setError(t(`global.${validation.error}`))
+      input.focus()
+      return
+    }
+    if (name() === session.name) {
+      close()
+      return
+    }
+    if (activeRenames.has(key)) {
+      setError(
+        text("该重命名仍在进行，请等待完成", "This rename is still running"),
+      )
+      return
+    }
+    activeRenames.add(key)
+    setBusy(true)
+    setError("")
+    try {
+      let response: any
+      setProgress(text("正在重命名…", "Renaming…"))
+      if (!ticket) {
+        response = await r.post("/fs/rename", {
+          path: pathJoin(session.directory, session.name),
+          name: name(),
+          overwrite: false,
+          staged: true,
+        })
+        if (response.code !== 200) throw new Error(response.message)
+        if (response.data?.jobId) {
+          const sourcePath = pathJoin(session.directory, session.name)
+          close()
+          if (pathname() === session.directory) refresh(undefined, true)
+          notify.success(text(
+            "目录已更名，正在同步 B2 中的文件名",
+            "Folder renamed; B2 names are syncing in the background",
+          ))
+          void (async () => {
+            try {
+              while (true) {
+                const step: any = await r.post("/fs/rename/b2/step", { path: sourcePath })
+                if (step.code !== 200 || !step.data) throw new Error(step.message)
+                if (step.data.done) break
+                if (step.data.state === "paused") throw new Error(step.data.error || "B2 rename paused")
+                await new Promise((resolve) => setTimeout(resolve, 250))
+              }
+              notify.success(text("B2 目录名称同步完成", "B2 folder rename completed"))
+              if (pathname() === session.directory) refresh(undefined, true)
+            } catch (error) {
+              notify.error(String(error))
+            }
+          })()
+          return
+        }
+        ticket = response.data?.ticket
+        if (ticket) remember()
+      }
+      while (ticket) {
+        if (me().id !== session.owner)
+          throw new Error(
+            text("账号已切换，操作已暂停", "Account changed; rename paused"),
+          )
+        response = await r.post("/fs/rename/step", { ticket })
+        if (response.code !== 200) throw new Error(response.message)
+        if (response.data.processed) processed++
+        ticket = response.data.done ? undefined : response.data.ticket
+        if (!response.data.done && !ticket)
+          throw new Error("Invalid rename continuation")
+        remember()
+        setProgress(
+          response.data.part
+            ? text(
+                `已处理 ${processed} 项，正在复制分段 ${response.data.part}/${response.data.parts}`,
+                `Processed ${processed}; copying part ${response.data.part}/${response.data.parts}`,
+              )
+            : text(
+                `已处理 ${processed} 项…`,
+                `Processed ${processed} item(s)…`,
+              ),
+        )
+      }
+      forget()
+      notify.success(t("global.success"))
+      close()
+      if (pathname() === session.directory && me().id === session.owner)
+        refresh(undefined, true)
+    } catch (error) {
+      setError(
+        String(error) +
+          (ticket
+            ? text(
+                "；已处理内容保留在新目录，剩余内容仍在原目录。按 Enter 继续。",
+                "; completed items remain in the new folder, remaining items in the original. Press Enter to resume.",
+              )
+            : ""),
+      )
+    } finally {
+      activeRenames.delete(key)
+      setBusy(false)
+      setProgress("")
+    }
+  }
+  return (
+    <form
+      class="drive-inline-rename"
+      onSubmit={(event) => {
+        event.preventDefault()
+        void submit()
+      }}
+      onMouseDown={(e) => e.stopPropagation()}
+      onClick={(e) => e.stopPropagation()}
+      onKeyDown={(e) => {
+        e.stopPropagation()
+        // Enter used to depend on implicit form submission, which differs
+        // across browsers. IME confirmation must not submit a partial name.
+        if (e.isComposing || e.keyCode === 229) return
+        if (e.key === "Enter") {
+          e.preventDefault()
+          void submit()
+        } else if (e.key === "Escape" && !busy()) {
+          e.preventDefault()
+          if (ticket)
+            setError(
+              text(
+                "文件夹重命名已开始，按 Enter 继续完成，避免留下未完成目录",
+                "Folder rename started; press Enter to resume",
+              ),
+            )
+          else close()
+        }
+      }}
+    >
+      <input
+        ref={input}
+        aria-label={t("home.toolbar.input_new_name")}
+        value={name()}
+        readOnly={busy() || !!ticket}
+        aria-busy={busy()}
+        enterkeyhint="done"
+        onBlur={() => {
+          if (!error()) void submit()
+        }}
+        aria-invalid={!!error()}
+        onInput={(e) => {
+          setName(e.currentTarget.value)
+          setError("")
+        }}
+      />
+      <Show when={progress()}>
+        <span class="drive-rename-progress" role="status">
+          {progress()}
+        </span>
+      </Show>
+      <Show when={error()}>
+        <span class="drive-rename-error" role="alert">
+          {error()}
+        </span>
+      </Show>
+    </form>
+  )
+}
