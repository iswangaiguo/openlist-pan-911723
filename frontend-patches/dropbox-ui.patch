+  align-items: center;
+}
+.drive-header-tools > button {
+  border-radius: 5px;
+}
+.drive-mobile-brand,
+.drive-mobile-settings {
+  display: none !important;
+}
+.drive-shell .body {
+  padding: 30px 0 0;
+  min-height: calc(100vh - 160px);
+  gap: 20px;
+}
+.drive-shell .nav {
+  background: var(--drive-bg);
+  font-size: 12px;
+  color: var(--drive-muted);
+}
+.drive-shell .nav::after {
+  display: none;
+}
+.drive-shell .nav-link {
+  padding: 3px 0;
+  border-radius: 3px;
+}
+.drive-heading {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  margin: 2px 0 10px;
+}
+.drive-heading h1 {
+  font-size: 30px;
+  font-weight: 600;
+  line-height: 1.25;
+  letter-spacing: -0.8px;
+  overflow-wrap: anywhere;
+  margin: 0;
+}
+.drive-actions {
+  display: flex;
+  gap: 10px;
+  align-items: center;
+  flex-shrink: 0;
+}
+.drive-button,
+.drive-icon-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 9px;
+  border: 1px solid var(--drive-line);
+  border-radius: 5px;
+  color: var(--drive-text);
+  background: var(--drive-bg);
+  min-height: 40px;
+  padding: 0 14px;
+  font-weight: 500 !important;
+}
+.drive-icon-button {
+  padding: 0;
+  width: 40px;
+  font-size: 18px !important;
+}
+.drive-button svg {
+  width: 17px;
+  height: 17px;
+}
+.drive-button:hover,
+.drive-icon-button:hover {
+  background: var(--drive-hover);
+  border-color: #b6b8be;
+}
+.drive-button-primary {
+  background: #0061ff;
+  color: white;
+  border-color: #0061ff;
+}
+.drive-button-primary:hover {
+  background: #0052d9;
+  border-color: #0052d9;
+}
+.drive-shell .obj-box {
+  padding: 0;
+  background: var(--drive-bg);
+  border-radius: 0;
+  box-shadow: none;
+}
+.drive-shell .list {
+  gap: 0;
+}
+.drive-shell .list .title {
+  padding: 12px 16px;
+  font-size: 12px;
+  color: var(--drive-muted);
+  border-bottom: 1px solid var(--drive-line);
+}
+.drive-shell .list-item {
+  padding: 18px 16px;
+  min-height: 64px;
+  border-radius: 0;
+  border-bottom: 1px solid var(--drive-line);
+  transition: background 0.15s;
+}
+.drive-shell .list-item:hover {
+  transform: none;
+  background: var(--drive-hover);
+}
+.drive-shell .list-item.selected {
+  background: var(--drive-selected);
+}
+.drive-shell .list-item .icon {
+  width: 28px;
+  height: 28px;
+  margin-right: 10px;
+  flex-shrink: 0;
+  color: var(--drive-blue);
+}
+.drive-shell .list-item .name {
+  font-weight: 500;
+}
+.drive-shell .list-item .size,
+.drive-shell .list-item .modified {
+  color: var(--drive-muted);
+  font-size: 13px;
+  font-variant-numeric: tabular-nums;
+}
+.drive-shell .footer {
+  color: var(--drive-muted);
+  font-size: 11px;
+  padding: 22px 0;
+}
+.drive-upload {
+  gap: 16px;
+}
+.drive-upload-file {
+  padding: 16px;
+  border-radius: 6px;
+  gap: 10px;
+}
+.drive-upload-file > p:first-child {
+  font-weight: 600;
+}
+.drive-upload-percent {
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+@media (max-width: 1100px) {
