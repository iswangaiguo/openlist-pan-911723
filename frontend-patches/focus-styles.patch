diff --git a/src/app/index.css b/src/app/index.css
index 0698907..5bb17a3 100644
--- a/src/app/index.css
+++ b/src/app/index.css
@@ -53,3 +53,39 @@
 .hope-notification__list {
   width: unset;
 }
+
+/* Keep focus on the control without browser or Hope UI focus frames. */
+:is(
+  button,
+  a,
+  input,
+  textarea,
+  select,
+  summary,
+  [tabindex],
+  [contenteditable="true"]
+):focus,
+:is(
+  .hope-checkbox__control,
+  .hope-radio__control,
+  .hope-switch__control
+)[data-focus] {
+  outline: none !important;
+  box-shadow: none !important;
+}
+
+:is(
+    .hope-checkbox__control,
+    .hope-radio__control,
+    .hope-switch__control
+  )[data-focus]:not([data-checked]):not([data-indeterminate]):not(
+    [data-invalid]
+  ) {
+  border-color: var(--hope-colors-neutral7) !important;
+}
+
+/* Text decoration provides a keyboard cue without adding a border. */
+:is(button, a, summary, [role="tab"], [role="menuitem"]):focus-visible {
+  text-decoration: underline;
+  text-underline-offset: 4px;
+}
