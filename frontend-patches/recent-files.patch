diff --git a/src/pages/home/recent/Recent.tsx b/src/pages/home/recent/Recent.tsx
new file mode 100644
index 0000000..9e4fb5a
--- /dev/null
+++ b/src/pages/home/recent/Recent.tsx
@@ -0,0 +1,430 @@
+import {
+  Icon,
+  Menu,
+  MenuContent,
+  MenuItem,
+  MenuTrigger,
+  ModalBody,
+  ModalFooter,
+  ModalHeader,
+  useColorModeValue,
+} from "@hope-ui/solid"
+import {
+  createEffect,
+  createMemo,
+  createSignal,
+  For,
+  on,
+  onCleanup,
+  onMount,
+  Show,
+} from "solid-js"
+import {
+  BsArrowClockwise,
+  BsArrowLeft,
+  BsClockHistory,
+  BsFolder2,
+  BsSearch,
+  BsThreeDots,
+  BsX,
+} from "solid-icons/bs"
+import { currentLang } from "~/app/i18n"
+import { useRouter, useTitle } from "~/hooks"
+import { me } from "~/store"
+import type { PageResp, Resp } from "~/types"
+import { encodePath, getFileSize, joinBase, pathDir, r } from "~/utils"
+import { getIconByObj } from "~/utils/icon"
+import {
+  Button,
+  DriveDialogScope,
+  Modal,
+  ModalContent,
+  ModalOverlay,
+} from "~/components/DriveDialog"
+import { Container } from "../Container"
+import { DriveAccount } from "../DriveChrome"
+import { recentText } from "./labels"
+import "../shares/shares.css"
+import "./recent.css"
+interface RecentFile {
+  path: string
+  name: string
+  size: number
+  type: number
+  opened_at: number
+}
+const Recent = () => {
+  const { to } = useRouter()
+  useTitle(recentText("title"))
+  const mode = useColorModeValue("light", "dark")
+  const signedIn = () => !!me().id && me().role !== 1 && !me().disabled
+  const [files, setFiles] = createSignal<RecentFile[]>([])
+  const [search, setSearch] = createSignal("")
+  const [loading, setLoading] = createSignal(false)
+  const [error, setError] = createSignal("")
+  const [busy, setBusy] = createSignal(false)
+  const [confirm, setConfirm] = createSignal(false)
+  let request: AbortController | undefined
+  let disposed = false
+  const refresh = async () => {
+    if (!signedIn() || busy()) return
+    request?.abort()
+    const current = new AbortController()
+    request = current
+    setLoading(true)
+    try {
+      const resp: PageResp<RecentFile> = await r.get("/recent/list", {
+        signal: current.signal,
+        timeout: 30000,
+      })
+      if (resp.code !== 200) throw new Error()
+      if (!disposed && !current.signal.aborted) {
+        setFiles(resp.data.content || [])
+        setError("")
+      }
+    } catch {
+      if (!disposed && !current.signal.aborted)
+        setError(recentText("load_error"))
+    } finally {
+      if (!disposed && request === current) setLoading(false)
+    }
+  }
+  const mutate = async (path?: string) => {
+    if (busy()) return
+    request?.abort()
+    setLoading(false)
+    setBusy(true)
+    const owner = identity()
+    setError("")
+    try {
+      const resp: Resp<null> = await r.post(
+        path ? "/recent/delete" : "/recent/clear",
+        path ? { path } : {},
+        { timeout: 30000 },
+      )
+      if (resp.code !== 200) throw new Error()
+      if (!disposed && identity() === owner) {
+        setFiles((prev) =>
+          path ? prev.filter((file) => file.path !== path) : [],
+        )
+        setConfirm(false)
+      }
+    } catch {
+      if (!disposed && identity() === owner)
+        setError(recentText("change_error"))
+    } finally {
+      if (!disposed && identity() === owner) setBusy(false)
+    }
+  }
+  const identity = () =>
+    `${me().id}:${me().base_path}:${me().role}:${me().disabled}`
+  createEffect(
+    on(identity, () => {
+      request?.abort()
+      setFiles([])
+      setBusy(false)
+      setConfirm(false)
+      setError("")
+      setSearch("")
+      if (signedIn()) void refresh()
+    }),
+  )
+  const visibleRefresh = () => {
+    if (document.visibilityState === "visible") void refresh()
+  }
+  const changed = (e: StorageEvent) => {
+    if (e.key === "openlist:recent-change") visibleRefresh()
+  }
+  onMount(() => {
+    window.addEventListener("focus", visibleRefresh)
+    window.addEventListener("storage", changed)
+    window.addEventListener("openlist:recent-change", visibleRefresh)
+    document.addEventListener("visibilitychange", visibleRefresh)
+    const timer = setInterval(visibleRefresh, 60000)
+    onCleanup(() => {
+      clearInterval(timer)
+      window.removeEventListener("focus", visibleRefresh)
+      window.removeEventListener("storage", changed)
+      window.removeEventListener("openlist:recent-change", visibleRefresh)
+      document.removeEventListener("visibilitychange", visibleRefresh)
+    })
+  })
+  onCleanup(() => {
+    disposed = true
+    request?.abort()
+  })
+  const filtered = createMemo(() => {
+    const value = search().trim().toLocaleLowerCase()
+    return files().filter((file) =>
+      `${file.name} ${file.path}`.toLocaleLowerCase().includes(value),
+    )
+  })
+  const open = (file: RecentFile) =>
+    window.open(
+      joinBase(encodePath(file.path)),
+      "_blank",
+      "noopener,noreferrer",
+    )
+  const date = (value: number) =>
+    new Intl.DateTimeFormat(
+      String(currentLang()).startsWith("zh") ? "zh-CN" : "en",
+      { dateStyle: "medium", timeStyle: "short" },
+    ).format(value)
+  return (
+    <DriveDialogScope>
+      <header class="drive-header">
+        <Container>
+          <div class="drive-header-inner">
+            <button
+              class="drive-icon-button drive-shares-back"
+              aria-label={recentText("files")}
+              onClick={() => to("/")}
+            >
+              <Icon as={BsArrowLeft} />
+            </button>
+            <label class="drive-search drive-shares-search">
+              <Icon as={BsSearch} />
+              <input
+                type="search"
+                aria-label={recentText("search")}
+                placeholder={recentText("search")}
+                value={search()}
+                onInput={(e) => setSearch(e.currentTarget.value)}
+              />
+            </label>
+            <div class="drive-header-tools">
+              <DriveAccount />
+            </div>
+          </div>
+        </Container>
+      </header>
+      <Container>
+        <section
+          class="drive-shares drive-recent"
+          aria-labelledby="drive-recent-title"
+        >
+          <div class="drive-heading">
+            <div>
+              <h1 id="drive-recent-title">{recentText("title")}</h1>
+              <p class="drive-shares-description">
+                {recentText("description")}
+              </p>
+            </div>
+            <Show when={signedIn()}>
+              <div class="drive-actions">
+                <button
+                  class="drive-icon-button"
+                  aria-label={recentText("refresh")}
+                  disabled={loading() || busy()}
+                  onClick={() => void refresh()}
+                >
+                  <Icon as={BsArrowClockwise} />
+                </button>
+                <button
+                  class="drive-button"
+                  disabled={!files().length || busy()}
+                  onClick={() => setConfirm(true)}
+                >
+                  {recentText("clear")}
+                </button>
+              </div>
+            </Show>
+          </div>
+          <Show when={error()}>
+            <div class="drive-share-error" role="alert">
+              {error()}
+              <button
+                class="drive-button"
+                disabled={loading() || busy()}
+                onClick={() => void refresh()}
+              >
+                {recentText("refresh")}
+              </button>
+            </div>
+          </Show>
+          <Show
+            when={signedIn()}
+            fallback={
+              <div class="drive-shares-empty">
+                <h2>{recentText("login")}</h2>
+                <button class="drive-button" onClick={() => to("/@login")}>
+                  {recentText("login")}
+                </button>
+              </div>
+            }
+          >
+            <Show
+              when={!loading() || files().length}
+              fallback={
+                <p class="drive-shares-empty" role="status">
+                  {recentText("loading")}
+                </p>
+              }
+            >
+              <Show
+                when={filtered().length}
+                fallback={
+                  <Show when={!error()}>
+                    <div class="drive-shares-empty">
+                      <span class="drive-shares-empty-icon">
+                        <Icon as={BsClockHistory} />
+                      </span>
+                      <h2>{recentText(files().length ? "none" : "empty")}</h2>
+                      <p>{recentText("empty_hint")}</p>
+                      <Show when={search()}>
+                        <button
+                          class="drive-button"
+                          onClick={() => setSearch("")}
+                        >
+                          {recentText("reset")}
+                        </button>
+                      </Show>
+                    </div>
+                  </Show>
+                }
+              >
+                <div class="drive-shares-table-wrap">
+                  <table
+                    class="drive-shares-table drive-recent-table"
+                    aria-label={recentText("title")}
+                    aria-busy={loading()}
+                  >
+                    <thead>
+                      <tr>
+                        <th scope="col">{recentText("name")}</th>
+                        <th scope="col">{recentText("opened")}</th>
+                        <th scope="col">{recentText("size")}</th>
+                        <th scope="col">{recentText("actions")}</th>
+                      </tr>
+                    </thead>
+                    <tbody>
+                      <For each={filtered()}>
+                        {(file) => (
+                          <tr>
+                            <td>
+                              <div class="drive-shares-name">
+                                <span class="drive-recent-icon">
+                                  <Icon
+                                    as={getIconByObj({
+                                      name: file.name,
+                                      type: file.type,
+                                      is_dir: false,
+                                    })}
+                                  />
+                                </span>
+                                <div>
+                                  <button
+                                    class="drive-shares-name-button"
+                                    onClick={() => open(file)}
+                                  >
+                                    {file.name}
+                                  </button>
+                                  <small title={pathDir(file.path)}>
+                                    {pathDir(file.path)}
+                                  </small>
+                                </div>
+                              </div>
+                            </td>
+                            <td data-label={recentText("opened")}>
+                              <time
+                                datetime={new Date(
+                                  file.opened_at,
+                                ).toISOString()}
+                              >
+                                {date(file.opened_at)}
+                              </time>
+                            </td>
+                            <td data-label={recentText("size")}>
+                              {getFileSize(file.size)}
+                            </td>
+                            <td>
+                              <div class="drive-shares-row-actions">
+                                <button
+                                  class="drive-button"
+                                  onClick={() => open(file)}
+                                >
+                                  {recentText("open")}
+                                </button>
+                                <Menu placement="bottom-end">
+                                  <MenuTrigger
+                                    as="button"
+                                    class="drive-icon-button"
+                                    aria-label={`${recentText("more")}: ${file.name}`}
+                                    disabled={busy()}
+                                  >
+                                    <Icon as={BsThreeDots} />
+                                  </MenuTrigger>
+                                  <MenuContent
+                                    class="drive-shares-menu"
+                                    data-drive-mode={mode()}
+                                  >
+                                    <MenuItem
+                                      icon={<Icon as={BsFolder2} />}
+                                      iconSpacing="12px"
+                                      onSelect={() =>
+                                        to(encodePath(pathDir(file.path)))
+                                      }
+                                    >
+                                      {recentText("location")}
+                                    </MenuItem>
+                                    <MenuItem
+                                      icon={<Icon as={BsX} />}
+                                      iconSpacing="12px"
+                                      onSelect={() => void mutate(file.path)}
+                                    >
+                                      {recentText("remove")}
+                                    </MenuItem>
+                                  </MenuContent>
+                                </Menu>
+                              </div>
+                            </td>
+                          </tr>
+                        )}
+                      </For>
+                    </tbody>
+                  </table>
+                </div>
+              </Show>
+            </Show>
+          </Show>
+        </section>
+      </Container>
+      <Modal
+        opened={confirm()}
+        onClose={() => {
+          if (!busy()) setConfirm(false)
+        }}
+      >
+        <ModalOverlay />
+        <ModalContent>
+          <ModalHeader>{recentText("clear_title")}</ModalHeader>
+          <ModalBody>
+            <p>{recentText("clear_hint")}</p>
+            <Show when={error()}>
+              <p class="drive-share-error" role="alert">
+                {error()}
+              </p>
+            </Show>
+          </ModalBody>
+          <ModalFooter>
+            <Button
+              colorScheme="neutral"
+              disabled={busy()}
+              onClick={() => setConfirm(false)}
+            >
+              {recentText("cancel")}
+            </Button>
+            <Button
+              colorScheme="danger"
+              loading={busy()}
+              onClick={() => void mutate()}
+            >
+              {recentText("clear")}
+            </Button>
+          </ModalFooter>
+        </ModalContent>
+      </Modal>
+    </DriveDialogScope>
+  )
+}
+export default Recent
