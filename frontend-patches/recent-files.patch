@@ -0,0 +1,37 @@
+import { me } from "~/store/user"
+import type { Obj, Resp } from "~/types"
+import { r } from "~/utils/request"
+
+// Record only successful, authenticated file navigation. Never persist signed
+// URLs, query strings, passwords, or public-share visits.
+export function recordRecent(
+  path: string,
+  obj: Pick<Obj, "size" | "type" | "is_dir">,
+) {
+  const user = me()
+  if (
+    !user.id ||
+    user.disabled ||
+    user.role === 1 ||
+    obj.is_dir ||
+    path.startsWith("/@")
+  )
+    return
+  void r
+    .post<Resp<unknown>, Resp<unknown>>(
+      "/recent/record",
+      { path, size: obj.size, type: obj.type },
+      { timeout: 10000 },
+    )
+    .then((resp) => {
+      if (resp.code !== 200) return
+      window.dispatchEvent(new Event("openlist:recent-change"))
+      try {
+        localStorage.setItem(
+          "openlist:recent-change",
+          `${user.id}:${Date.now()}`,
+        )
+      } catch {}
+    })
+    .catch(() => {})
+}
