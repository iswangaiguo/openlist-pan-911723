+  opened: ["最近打开", "Last opened"],
+  size: ["大小", "Size"],
+  actions: ["操作", "Actions"],
+  refresh: ["刷新", "Refresh"],
+  clear: ["清空记录", "Clear history"],
+  clear_title: ["清空最近使用记录？", "Clear recent history?"],
+  clear_hint: [
+    "只清空此账号的使用记录，文件仍保留在原位置。",
+    "This clears your account’s history. Your files remain in their original locations.",
