+  remove: ["移除记录", "Remove from recents"],
+  open: ["打开文件", "Open file"],
+  location: ["打开所在文件夹", "Open containing folder"],
+  more: ["更多操作", "More actions"],
+  empty: ["还没有最近使用的文件", "No recent files yet"],
+  empty_hint: [
+    "打开文件后，它会出现在这里。",
+    "Files you open will appear here.",
+  ],
+  none: ["没有找到匹配的文件", "No matching files"],
+  reset: ["清除搜索", "Clear search"],
+  login: ["登录后查看最近使用", "Sign in to see recent files"],
+  loading: ["正在加载最近使用…", "Loading recent files…"],
+  load_error: [
+    "无法加载最近使用，请重试。",
+    "Unable to load recent files. Please retry.",
