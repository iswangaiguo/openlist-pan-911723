{
  "name": "openlist-pan-911723",
  "main": "src/backend/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "preview_urls": false,
  // Advance persisted B2 rename jobs even after the browser has been closed.
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // HTML entries must reach the Worker to apply revalidation headers.
    // Versioned JS, CSS and images keep direct static-asset serving.
    "run_worker_first": ["/", "/index.html"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "DB_FORMAT": "sql",
    "DB_DRIVER": "d1",
    "DB_CIPHER": "aes-256-gcm",
    "DIRECTORY_CACHE_ENABLED": "true",
    "DIRECTORY_CACHE_MAX_SECONDS": "300"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "openlist-911723" }
  ]
}
